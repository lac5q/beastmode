# Beastmode repo gitignore

# Pi package install state (user-level, never committed)
.pi/*
!.pi/extensions/
.pi/extensions/*
!.pi/extensions/pi-permission-system/
.pi/extensions/pi-permission-system/*
!.pi/extensions/pi-permission-system/config.json
.pnpm-store/

# Local skill discovery copy (alternative location; the canonical home is pi/)
.agents/skills/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Node — only if a pi package build step is added later
node_modules/
*.log

# Python bytecode from the stdlib helpers in scripts/
__pycache__/
*.pyc

# Local LangGraph development environment; never committed.
.venv/
.beastmode/
.langgraph_api/
.codex/beastmode-runs/

# Local credentials and key material; keep examples explicit and reviewable.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
auth.json
.npmrc
.pypirc
.netrc
.git-credentials
.docker/config.json
.config/gh/hosts.yml
.aws/
.kube/
*kubeconfig*
application_default_credentials.json
*.sqlite
*.sqlite3

# Python package build/test artifacts.
python/build/
python/dist/
python/.pytest_cache/
python/src/*.egg-info/
