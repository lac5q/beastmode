#!/usr/bin/env bash
# claude-pro — Beastmode Claude Pro lane wrapper.
#
# Routes Claude work through the local Claude Code CLI in non-interactive
# print mode. Uses the claude.ai Pro/Max subscription quota (NOT the API
# OAuth credential in ~/.pi/agent/auth.json, which shares an "extra usage"
# pool across every Claude model and is rate-limited).
#
# Usage:
#   printf '%s' "<prompt>" | claude-pro
#   printf '%s' "<prompt>" | claude-pro --model opus
#   printf '%s' "<prompt>" | claude-pro --model sonnet --effort high
#   cat prompt.txt | claude-pro           # multi-line prompt via stdin
#
# This is the beastmode Claude external lane. See
# ~/.agents/skills/beastmode-pi/SKILL.md "Claude routing rule".

set -euo pipefail

# Sanity: refuse if the Claude Code CLI is missing.
if ! command -v claude >/dev/null 2>&1; then
  echo "claude-pro: 'claude' CLI not found in PATH. Install Claude Code: https://docs.claude.com/en/docs/claude-code" >&2
  exit 127
fi

# Default model: opus. Override with --model.
MODEL="opus"
# Reasoning effort is opt-in: empty means "let the CLI pick its own default",
# which preserves the behaviour of callers that never pass --effort.
EFFORT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --model)
      [[ $# -ge 2 ]] || { echo "claude-pro: --model requires an argument" >&2; exit 2; }
      MODEL="$2"
      shift 2
      ;;
    --model=*)
      MODEL="${1#--model=}"
      shift
      ;;
    --effort)
      [[ $# -ge 2 ]] || { echo "claude-pro: --effort requires an argument" >&2; exit 2; }
      EFFORT="$2"
      shift 2
      ;;
    --effort=*)
      EFFORT="${1#--effort=}"
      shift
      ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "claude-pro: prompts are accepted only on stdin; unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [[ -z "$MODEL" || "$MODEL" == -* || "$MODEL" == */* || "$MODEL" =~ [[:space:][:cntrl:]] ]]; then
  echo "claude-pro: --model must be a bare Claude model id or alias" >&2
  exit 2
fi

# Closed enum: the Claude Code CLI accepts exactly these levels. Validating
# against a fixed set also keeps the value from ever being read as a flag.
if [[ -n "$EFFORT" && ! "$EFFORT" =~ ^(low|medium|high|xhigh|max)$ ]]; then
  echo "claude-pro: --effort must be low|medium|high|xhigh|max (got: $EFFORT)" >&2
  exit 2
fi

PROMPT="$(cat)"

if [[ -z "$PROMPT" ]]; then
  echo "claude-pro: no prompt provided (argv or stdin)" >&2
  exit 2
fi

# This wrapper is a watcher/verifier lane. Plan mode keeps it useful for
# read-only judgment while failing closed instead of granting unattended tools.
# The signed-in Claude Code lane must not inherit an API token, custom API
# endpoint, or Beastmode's legacy API-OAuth authorization marker. Clearing
# these values prevents an Anthropic seat from silently taking an API path.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL BM_ALLOW_CLAUDE_OAUTH

CLAUDE_ARGS=(-p --permission-mode plan --model "$MODEL")
[[ -n "$EFFORT" ]] && CLAUDE_ARGS+=(--effort "$EFFORT")

printf '%s' "$PROMPT" | claude "${CLAUDE_ARGS[@]}"
