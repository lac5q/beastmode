#!/usr/bin/env python3
"""Small CLI bridge for ``bm --harness langgraph``.

The existing shell runner remains the default and never imports this module.
This bridge intentionally fails with an install hint when the optional
runtime is absent instead of exposing a Python traceback to bash users.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shlex
import stat
import sys
from collections.abc import Mapping
from dataclasses import dataclass
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "python" / "src"))


def _run_dir_component(thread_id: str) -> str:
    """Use a non-sensitive, traversal-proof component for the default run dir."""
    digest = hashlib.sha256(thread_id.encode("utf-8")).hexdigest()[:24]
    return f"goal-{digest}"


def _state_base() -> Path:
    """Keep parent-owned runtime state outside the target repository."""
    configured = os.environ.get("XDG_STATE_HOME")
    root = Path(configured).expanduser() if configured else Path.home() / ".local" / "state"
    return root / "beastmode"


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="langgraph-runner")
    parser.add_argument("goal")
    parser.add_argument("--repo", default=None, help="repository to isolate child worktrees from (default: cwd)")
    parser.add_argument("--graph", choices=("pipeline",), default="pipeline")
    parser.add_argument("--autonomy", choices=("low", "medium", "high"), default="medium")
    parser.add_argument("--thread-id", default=None)
    parser.add_argument("--database", default=None)
    parser.add_argument("--run-dir", default=None)
    parser.add_argument("--resume", default=None)
    parser.add_argument("--frontier", default=None)
    parser.add_argument("--economy", default=None)
    parser.add_argument("--watcher", default=None)
    parser.add_argument(
        "--executor-command",
        default=None,
        help="argv string run once per child worktree; child writes $BEASTMODE_META_DIR/meta.json",
    )
    parser.add_argument(
        "--attestor-command",
        default=None,
        help="trusted absolute executable; reads task JSON on stdin and returns an attestation object",
    )
    parser.add_argument(
        "--validator-command",
        default=None,
        help="trusted absolute executable; reads state JSON and returns validation_report",
    )
    parser.add_argument(
        "--reviewer-command",
        default=None,
        help="trusted absolute executable; reads state JSON and returns review_report",
    )
    parser.add_argument("--worktree-root", default=None)
    parser.add_argument(
        "--allow-worker-network",
        action="store_true",
        help="explicitly share network with the sandboxed worker command",
    )
    parser.add_argument("--mermaid", action="store_true", help="print the selected graph and exit")
    return parser


@dataclass(frozen=True)
class _TrustedHelper:
    path: Path
    fd: int


def _trusted_helper(raw: str | None, *, repo: Path, label: str) -> _TrustedHelper:
    if not raw:
        raise ValueError(f"--{label}-command is required")
    try:
        parts = tuple(shlex.split(raw))
    except ValueError as exc:
        raise ValueError(f"invalid --{label}-command: {exc}") from exc
    if len(parts) != 1:
        raise ValueError(
            f"--{label}-command must be one absolute executable without shell arguments"
        )
    path = Path(parts[0])
    if not path.is_absolute() or path.is_symlink() or not path.is_file():
        raise ValueError(f"--{label}-command must name a regular absolute executable")
    resolved = path.resolve()
    if resolved == repo or repo in resolved.parents:
        raise ValueError(f"--{label}-command must be outside the target repository")
    metadata = resolved.stat()
    if metadata.st_uid not in {0, os.geteuid()} or stat.S_IMODE(metadata.st_mode) & 0o022:
        raise ValueError(
            f"--{label}-command must be owned by root/current user and not group/world writable"
        )
    if not os.access(resolved, os.X_OK):
        raise ValueError(f"--{label}-command is not executable")
    parent = resolved.parent
    parent_metadata = parent.stat()
    if (
        parent_metadata.st_uid not in {0, os.geteuid()}
        or stat.S_IMODE(parent_metadata.st_mode) & 0o022
    ):
        raise ValueError(
            f"--{label}-command parent directory must not be group/world writable"
        )
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(resolved, flags)
    opened = os.fstat(descriptor)
    if (opened.st_dev, opened.st_ino) != (metadata.st_dev, metadata.st_ino):
        os.close(descriptor)
        raise ValueError(f"--{label}-command changed while it was being verified")
    return _TrustedHelper(path=resolved, fd=descriptor)


def _json_callback(command: _TrustedHelper, *, required_key: str | None):
    def invoke(payload):
        from beastmode.core.executors.subprocess import _run_bounded

        encoded = json.dumps(payload, separators=(",", ":"), default=str).encode()
        if len(encoded) > 1024 * 1024:
            raise ValueError("trusted helper input exceeds 1 MiB")
        env = {
            key: value
            for key, value in os.environ.items()
            if key in {"LANG", "LC_ALL", "LC_CTYPE"} or key.startswith("LC_")
        }
        env["PATH"] = os.pathsep.join(
            path
            for path in (
                "/usr/local/sbin",
                "/usr/local/bin",
                "/usr/sbin",
                "/usr/bin",
                "/sbin",
                "/bin",
            )
            if Path(path).is_dir()
        )
        completed = _run_bounded(
            (f"/proc/self/fd/{command.fd}",),
            input_data=encoded,
            cwd=Path("/"),
            env=env,
            timeout=30.0,
            max_stdout_bytes=1024 * 1024,
            max_stderr_bytes=64 * 1024,
            terminate_on_output_limit=True,
            pass_fds=(command.fd,),
        )
        if completed.output_exhausted:
            raise ValueError("trusted helper output exceeds its bound")
        if completed.returncode != 0:
            raise RuntimeError(
                f"trusted helper failed with exit {completed.returncode}"
            )
        try:
            value = json.loads(completed.stdout)
        except json.JSONDecodeError as exc:
            raise ValueError("trusted helper did not return one JSON object") from exc
        if not isinstance(value, dict):
            raise ValueError("trusted helper result must be a JSON object")
        if required_key is not None and not isinstance(value.get(required_key), dict):
            raise ValueError(f"trusted helper result must contain {required_key}")
        return value

    return invoke


def main(argv: list[str] | None = None) -> int:
    try:
        from beastmode.core.executors.subprocess import WorktreeSubprocessExecutor
        from beastmode.langgraph.nodes import PipelineDependencies
        from beastmode.langgraph.runtime import run_pipeline
    except ModuleNotFoundError as exc:
        if exc.name and exc.name.startswith("langgraph"):
            print(
                "bm: --harness langgraph needs the optional runtime; "
                "install with: python -m pip install 'beastmode[langgraph]'",
                file=sys.stderr,
            )
            return 2
        raise

    args = _parser().parse_args(argv)
    project_root = Path(args.repo or Path.cwd()).resolve()
    if args.mermaid:
        from beastmode.langgraph.graphs.pipeline import build_pipeline

        print(build_pipeline().get_graph().draw_mermaid())
        return 0
    if not args.executor_command:
        print(
            "bm: --harness langgraph needs --executor-command for a real goal; "
            "the child command must write $BEASTMODE_META_DIR/meta.json",
            file=sys.stderr,
        )
        return 2
    try:
        command = tuple(shlex.split(args.executor_command))
    except ValueError as exc:
        print(f"bm: invalid --executor-command: {exc}", file=sys.stderr)
        return 2
    if not command:
        print("bm: --executor-command cannot be empty", file=sys.stderr)
        return 2
    try:
        attestor_command = _trusted_helper(
            args.attestor_command, repo=project_root, label="attestor"
        )
        validator_command = _trusted_helper(
            args.validator_command, repo=project_root, label="validator"
        )
        reviewer_command = _trusted_helper(
            args.reviewer_command, repo=project_root, label="reviewer"
        )
    except ValueError as exc:
        print(f"bm: {exc}", file=sys.stderr)
        return 2
    thread_id = args.thread_id or args.goal
    state_base = _state_base()
    default_db = state_base / "langgraph.sqlite"
    database = Path(args.database or os.environ.get("BEASTMODE_LANGGRAPH_DB", default_db))
    run_dir = Path(
        args.run_dir
        or (state_base / "runs" / _run_dir_component(thread_id))
    )
    # Keep the graph's default aligned with the shell/Pi runners: every
    # economy child is explicitly pinned to Luna Max unless the caller names
    # another reviewed lane.
    executor_model = args.economy or "openai-codex/gpt-5.6-luna"
    executor = WorktreeSubprocessExecutor(
        repo=project_root,
        command=command,
        worktree_root=Path(args.worktree_root).resolve()
        if args.worktree_root
        else None,
        allow_network=args.allow_worker_network,
        model_attestor=_json_callback(attestor_command, required_key=None),
    )
    dependencies = PipelineDependencies(
        executor=executor,
        validator=_json_callback(validator_command, required_key="validation_report"),
        reviewer=_json_callback(reviewer_command, required_key="review_report"),
    )
    state = {
        "goal": args.goal,
        "repo": str(project_root),
        "autonomy": args.autonomy,
        "director_model": args.frontier or "unconfigured/director",
        "executor_model": executor_model,
        "watcher_model": args.watcher or "unconfigured/watcher",
        "concurrency": 3,
        "run_dir": str(run_dir),
        "tasks": [
            {
                "id": "goal",
                "goal": args.goal,
                "lane": "economy",
                "allowed_paths": [],
                "verify_cmds": [],
                "requested_model": executor_model,
            }
        ],
        "requested_seats": {
            "frontier": args.frontier,
            "economy": executor_model,
            "watcher": args.watcher,
        },
    }
    result = run_pipeline(
        state,
        goal_id=thread_id,
        autonomy=args.autonomy,
        database=database,
        run_dir=run_dir,
        attestations=executor.attestation_directory_for(run_dir),
        attestation_key=executor.attestation_key,
        attestation_run_id=executor.attestation_run_id,
        dependencies=dependencies,
        resume=args.resume,
    )
    print(json.dumps(result, indent=2, default=str))
    return _exit_code(result, _write_lifecycle_summary(result))


def _interrupt_payloads(result: Mapping[str, Any]) -> list[Any]:
    interrupts = result.get("__interrupt__")
    if not isinstance(interrupts, (list, tuple)):
        return []
    payloads: list[Any] = []
    for item in interrupts[:8]:
        value = getattr(item, "value", item)
        payloads.append(value if isinstance(value, (dict, str, int, float, bool)) or value is None else str(value))
    return payloads


def _write_lifecycle_summary(result: Mapping[str, Any]) -> dict[str, Any] | None:
    """Under `bm goal run` the supervisor names a parent-owned summary path.

    The summary is the trusted bridge between the graph's final state and the
    goal record: interrupts become awaiting_approval, the provenance verdict
    and review report become the revision-bound acceptance record. It is
    written only where the supervisor asked (outside the worker run_dir).
    """
    target = os.environ.get("BM_LIFECYCLE_SUMMARY")
    if not target:
        return None
    path = Path(target).expanduser().absolute()
    if not path.parent.is_dir():
        raise SystemExit(f"langgraph-runner: BM_LIFECYCLE_SUMMARY parent missing: {path.parent}")
    validation = result.get("validation_report")
    review = result.get("review_report")
    summary = {
        "contract_version": "1.0",
        "status": result.get("status"),
        "phase": result.get("phase"),
        "interrupt": _interrupt_payloads(result),
        "preflight_ok": result.get("preflight_ok") is True,
        "validation_report": dict(validation) if isinstance(validation, Mapping) else None,
        "provenance_verdict": result.get("provenance_verdict") or "unverifiable",
        "provenance_messages": [str(m)[:1024] for m in (result.get("provenance_messages") or [])[:32]],
        "ok_children": [
            str(item.get("id"))
            for item in (result.get("task_results") or [])[:64]
            if isinstance(item, Mapping) and item.get("status") == "completed"
        ],
        "review_report": dict(review) if isinstance(review, Mapping) else None,
        "merge_decision": result.get("merge_decision"),
        "merged": result.get("status") == "merged",
    }
    body = json.dumps(summary, indent=2, default=str, sort_keys=True)
    tmp = path.with_name(path.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(body)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, path)
    return summary


def _exit_code(result: Mapping[str, Any], summary: Mapping[str, Any] | None) -> int:
    """Exit codes follow schema/goal-lifecycle.json when supervised.

    Standalone invocations keep the historical contract (0 only after a
    merge). Under `bm goal run` a pending interrupt exits 4 and a validated,
    reviewed goal exits 0 whether or not it was also merged: completion is an
    acceptance record, not a merge.
    """
    if summary is None:
        return 0 if result.get("status") == "merged" else 1
    if summary["interrupt"]:
        return 4
    if result.get("status") == "merged":
        return 0
    validation = summary.get("validation_report")
    review = summary.get("review_report")
    if (
        summary.get("preflight_ok")
        and isinstance(validation, Mapping)
        and validation.get("passed") is True
        and summary.get("provenance_verdict") == "ok"
        and isinstance(review, Mapping)
        and review.get("approved") is True
        and result.get("status") == "ready_to_merge"
    ):
        return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
