#!/usr/bin/env bash
# Fail-closed guard for credentials, private paths, and credential-like files.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

TREEISH="HEAD"
HISTORY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --history) HISTORY=1; shift ;;
    --treeish)
      [ $# -ge 2 ] || { printf '%s\n' "public-artifact-guard: --treeish requires a revision" >&2; exit 2; }
      TREEISH="$2"
      shift 2
      ;;
    --treeish=*) TREEISH="${1#*=}"; shift ;;
    -h|--help)
      printf '%s\n' "usage: public-artifact-guard [--treeish REV] [--history]"
      exit 0
      ;;
    *) printf 'public-artifact-guard: unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done

if [[ -z "$TREEISH" || "$TREEISH" == -* ]]; then
  printf '%s\n' "public-artifact-guard: invalid treeish" >&2
  exit 2
fi
TARGET="$(git rev-parse --verify "${TREEISH}^{commit}" 2>/dev/null)" || {
  printf 'public-artifact-guard: could not resolve treeish: %s\n' "$TREEISH" >&2
  exit 2
}

scan_for_matches() {
  local label="$1"
  shift
  local matches rc
  set +e
  matches="$("$@" 2>&1)"
  rc=$?
  set -e
  case "$rc" in
    0)
      printf '%s\n' "${label} found in tracked files:" >&2
      printf '%s\n' "$matches" >&2
      return 1
      ;;
    1)
      return 0
      ;;
    *)
      printf '%s scanner failed with exit %s:\n%s\n' "$label" "$rc" "$matches" >&2
      return 2
      ;;
  esac
}

scan_for_matches "Potential credential material" git grep -l -E \
  'AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{20,}' "$TARGET" -- .
scan_for_matches "Machine-specific absolute paths" git grep -l -E \
  '/(home|Users)/[[:alnum:]_.-]+|C:[\\/]+Users[\\/]+[[:alnum:]_.-]+' "$TARGET" -- .

tracked_files="$(git ls-tree -r --name-only "$TARGET")" || {
  printf '%s\n' "tracked-file scanner failed" >&2
  exit 2
}
blocked_files=()
while IFS= read -r path; do
  if [[ "$path" =~ (^|/)(\.env($|\.)|.*\.(pem|key|p12|pfx|sqlite|sqlite3)$|auth\.json$|credentials\.json$) ]]; then
    blocked_files+=("$path")
  fi
done <<< "$tracked_files"
if ((${#blocked_files[@]})); then
  printf '%s\n' "Credential-like files are tracked:" >&2
  printf '  %s\n' "${blocked_files[@]}" >&2
  exit 1
fi

if [ "$HISTORY" = "1" ]; then
  history_matches="$(git log "$TARGET" -E -G 'AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{20,}|/(home|Users)/[[:alnum:]_.-]+' --format='%H %s' -- .)" || {
    printf '%s\n' "history scanner failed" >&2
    exit 2
  }
  if [ -n "$history_matches" ]; then
    printf '%s\n%s\n' "Sensitive-looking history changes found:" "$history_matches" >&2
    exit 1
  fi
fi

printf 'public artifact guard: clean (%s)\n' "$TARGET"
