#!/usr/bin/env bash
# Fail-closed guard for credentials, private paths, and release artifacts.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

TREEISH="HEAD"
HISTORY=0
ARTIFACTS=()
MAX_RECORD_BYTES=$((64 * 1024 * 1024))
MAX_OBJECTS=200000
MAX_BLOB_BYTES=$((32 * 1024 * 1024))

while [ $# -gt 0 ]; do
  case "$1" in
    --history) HISTORY=1; shift ;;
    --treeish)
      [ $# -ge 2 ] || { printf '%s\n' "public-artifact-guard: --treeish requires a revision" >&2; exit 2; }
      TREEISH="$2"
      shift 2
      ;;
    --treeish=*) TREEISH="${1#*=}"; shift ;;
    --artifact)
      [ $# -ge 2 ] || { printf '%s\n' "public-artifact-guard: --artifact requires a path" >&2; exit 2; }
      ARTIFACTS+=("$2")
      shift 2
      ;;
    --artifact=*) ARTIFACTS+=("${1#*=}"); shift ;;
    -h|--help)
      printf '%s\n' "usage: public-artifact-guard [--treeish REV] [--history] [--artifact PATH ...]"
      exit 0
      ;;
    *) printf 'public-artifact-guard: unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done

if [[ -z "$TREEISH" || "$TREEISH" == -* ]]; then
  printf '%s\n' "public-artifact-guard: invalid treeish" >&2
  exit 2
fi

GIT_CANDIDATE="$(command -v git 2>/dev/null || true)"
if [ -z "$GIT_CANDIDATE" ] || [[ "$GIT_CANDIDATE" != /* ]]; then
  printf '%s\n' "public-artifact-guard: trusted Git executable is unavailable" >&2
  exit 2
fi
GIT_BIN="$(readlink -f -- "$GIT_CANDIDATE" 2>/dev/null || true)"
if [ ! -x "$GIT_BIN" ] || [ ! -f "$GIT_BIN" ]; then
  printf '%s\n' "public-artifact-guard: Git must resolve to an executable regular file" >&2
  exit 2
fi
case "$GIT_BIN" in
  "$ROOT"|"$ROOT"/*)
    printf '%s\n' "public-artifact-guard: repository-local Git is not trusted" >&2
    exit 2
    ;;
esac
ancestor="$GIT_BIN"
while [ "$ancestor" != "/" ]; do
  # GNU stat first, BSD/macOS stat as fallback; both follow symlinks.
  mode="$(stat -Lc '%a' -- "$ancestor" 2>/dev/null || stat -Lf '%Lp' -- "$ancestor" 2>/dev/null || true)"
  owner="$(stat -Lc '%u' -- "$ancestor" 2>/dev/null || stat -Lf '%u' -- "$ancestor" 2>/dev/null || true)"
  { [ -n "$mode" ] && [ -n "$owner" ]; } || { printf '%s\n' "public-artifact-guard: cannot verify Git path" >&2; exit 2; }
  if (( (8#$mode & 0002) != 0 )); then
    printf '%s\n' "public-artifact-guard: Git path has world-writable components" >&2
    exit 2
  fi
  # Group-writable is only a trust boundary when the component is not already
  # owned by root or the invoking user (Homebrew prefixes are user-owned and
  # admin-group-writable by default on macOS).
  if (( (8#$mode & 0020) != 0 )) && [ "$owner" != "0" ] && [ "$owner" != "$(id -u)" ]; then
    printf '%s\n' "public-artifact-guard: Git path has group-writable components not owned by root or the invoking user" >&2
    exit 2
  fi
  ancestor="$(dirname -- "$ancestor")"
done

TARGET="$("$GIT_BIN" rev-parse --verify "${TREEISH}^{commit}" 2>/dev/null)" || {
  printf 'public-artifact-guard: could not resolve treeish: %s\n' "$TREEISH" >&2
  exit 2
}

# Character-class splits keep this source from matching its own signatures.
CREDENTIAL_PATTERN='AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9_]{20,}|github_[p]at_[A-Za-z0-9_]{20,}|n[p]m_[A-Za-z0-9]{20,}|pyp[i]-[A-Za-z0-9_-]{20,}|glpa[t]-[A-Za-z0-9_-]{20,}|h[f]_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}|sk-[p]roj-[A-Za-z0-9_-]{16,}|sk-[a]nt-[A-Za-z0-9_-]{16,}|xox[baprs]-[A-Za-z0-9-]{20,}|pass(word|wd)[[:space:]]*[:=][[:space:]]*[^[:space:]\"]{8,}'
PRIVATE_PATH_PATTERN='/(h[o]me|U[s]ers)/[[:alnum:]_.-]+|C:[\\/]+U[s]ers[\\/]+[[:alnum:]_.-]+'
# Endpoint hosts are deny-by-default: anything not listed here counts as a
# private endpoint (self-hosted proxy, tenant subdomain, internal service).
# Listing a host is a deliberate publishing decision, which is the point — a
# private base URL cannot reach the public repo by accident. RFC 2606/6761
# reserved names are permitted so fixtures and docs can use them freely.
PUBLIC_HOST_PATTERN='(127\.0\.0\.1|0\.0\.0\.0|localhost|api\.anthropic\.com|api\.minimax\.io|api\.smith\.langchain\.com|changelog\.langchain\.com|docs\.claude\.com|docs\.langchain\.com|reference\.langchain\.com|fast\.io|github\.com|raw\.githubusercontent\.com|objects\.githubusercontent\.com|pypi\.org|files\.pythonhosted\.org|registry\.npmjs\.org|www\.diagrid\.io|www\.jahanzaib\.ai|www\.w3\.org|example\.(com|net|org)|([A-Za-z0-9-]+\.)*(invalid|test|example|localhost))'
BLOCKED_PATH_PATTERN='(^|/)(\.env($|\.)|\.npmrc$|\.pypirc$|\.netrc$|\.git-credentials$|.*\.(pem|key|p12|pfx|sqlite|sqlite3)$|auth\.json$|credentials\.json$|application_default_credentials\.json$|\.docker/config\.json$|\.config/gh/hosts\.yml$|\.aws/(credentials|config)$|\.kube/config$|[^/]*kubeconfig[^/]*$)'

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

git_to_file() {
  local output="$1"
  shift
  set +e
  (ulimit -f $((MAX_RECORD_BYTES / 512)); exec "$GIT_BIN" "$@") > "$output" 2>/dev/null
  local rc=$?
  set -e
  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "public-artifact-guard: Git enumeration failed or exceeded its bound" >&2
    exit 2
  fi
}

# Returns 0 when every endpoint host in "$TMP/blob" is allowlisted, 1 otherwise.
# The offending host is deliberately NOT printed: this guard runs in CI for a
# public repository, so echoing it would publish the very value being blocked.
# Set BEASTMODE_GUARD_SHOW_HOST=1 for a local run when you need to find it.
scan_blob_hosts() {
  local host
  host="$(LC_ALL=C grep -aoE 'https?://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?' "$TMP/blob" 2>/dev/null \
    | sed -E 's|^https?://||' \
    | LC_ALL=C grep -avxE "$PUBLIC_HOST_PATTERN" \
    | head -n 1 || true)"
  [ -z "$host" ] && return 0
  if [ "${BEASTMODE_GUARD_SHOW_HOST:-0}" = "1" ]; then
    printf 'public-artifact-guard: non-public endpoint host: %s\n' "$host" >&2
  fi
  return 1
}

scan_paths() {
  local input="$1" path count=0
  while IFS= read -r -d '' path; do
    count=$((count + 1))
    if [ "$count" -gt "$MAX_OBJECTS" ]; then
      printf '%s\n' "public-artifact-guard: path count exceeds safety bound" >&2
      exit 2
    fi
    if [[ "$path" =~ [[:cntrl:]] ]] || [[ "$path" =~ $BLOCKED_PATH_PATTERN ]]; then
      printf '%s\n' "public-artifact-guard: credential-like filename found" >&2
      return 1
    fi
  done < "$input"
}

scan_blob_ids() {
  local input="$1" hash type size count=0 grep_rc
  declare -A seen=()
  while IFS= read -r hash; do
    [ -n "$hash" ] || continue
    [[ "$hash" =~ ^[0-9a-fA-F]{40,64}$ ]] || {
      printf '%s\n' "public-artifact-guard: invalid object id from Git" >&2
      exit 2
    }
    [ -z "${seen[$hash]+x}" ] || continue
    seen[$hash]=1
    count=$((count + 1))
    if [ "$count" -gt "$MAX_OBJECTS" ]; then
      printf '%s\n' "public-artifact-guard: object count exceeds safety bound" >&2
      exit 2
    fi
    type="$("$GIT_BIN" cat-file -t "$hash" 2>/dev/null || true)"
    [ "$type" = "blob" ] || continue
    size="$("$GIT_BIN" cat-file -s "$hash" 2>/dev/null || true)"
    [[ "$size" =~ ^[0-9]+$ ]] || { printf '%s\n' "public-artifact-guard: cannot size blob" >&2; exit 2; }
    if [ "$size" -gt "$MAX_BLOB_BYTES" ]; then
      printf '%s\n' "public-artifact-guard: blob exceeds safety bound" >&2
      exit 2
    fi
    "$GIT_BIN" cat-file blob "$hash" > "$TMP/blob" 2>/dev/null || {
      printf '%s\n' "public-artifact-guard: cannot read blob" >&2
      exit 2
    }
    set +e
    LC_ALL=C grep -aEq "$CREDENTIAL_PATTERN|$PRIVATE_PATH_PATTERN" "$TMP/blob"
    grep_rc=$?
    set -e
    case "$grep_rc" in
      0) printf '%s\n' "public-artifact-guard: sensitive material found in repository blob" >&2; return 1 ;;
      1) ;;
      *) printf '%s\n' "public-artifact-guard: blob scanner failed" >&2; exit 2 ;;
    esac
    if ! scan_blob_hosts; then
      printf '%s\n' "public-artifact-guard: non-public endpoint host found in repository blob" >&2
      printf '%s\n' "public-artifact-guard: re-run locally with BEASTMODE_GUARD_SHOW_HOST=1 to identify it" >&2
      return 1
    fi
  done < "$input"
}

git_to_file "$TMP/paths" ls-tree -r -z --name-only "$TARGET"
scan_paths "$TMP/paths"
git_to_file "$TMP/objects" ls-tree -r --format='%(objectname)' "$TARGET"
scan_blob_ids "$TMP/objects"

if [ "$HISTORY" = "1" ]; then
  shallow="$("$GIT_BIN" rev-parse --is-shallow-repository 2>/dev/null)" || {
    printf '%s\n' "public-artifact-guard: cannot determine history completeness" >&2
    exit 2
  }
  if [ "$shallow" != "false" ]; then
    printf '%s\n' "public-artifact-guard: history scan refuses a shallow repository" >&2
    exit 2
  fi
  git_to_file "$TMP/history-paths" log --all --format= --name-only -z --no-renames -- .
  scan_paths "$TMP/history-paths"
  git_to_file "$TMP/history-objects" rev-list --objects --all --no-object-names
  scan_blob_ids "$TMP/history-objects"
fi

if ((${#ARTIFACTS[@]})); then
  PYTHON_BIN="$(command -v python3 2>/dev/null || true)"
  if [ -z "$PYTHON_BIN" ]; then
    printf '%s\n' "public-artifact-guard: python3 is required to scan distribution archives" >&2
    exit 2
  fi
  for artifact in "${ARTIFACTS[@]}"; do
    "$PYTHON_BIN" "$ROOT/scripts/lib/scan-public-archive.py" "$artifact" || exit $?
  done
fi

printf 'public artifact guard: clean (%s; artifacts=%s)\n' "$TARGET" "${#ARTIFACTS[@]}"
