#!/usr/bin/env bash
# enforce-models — preflight + postflight model check for beastmode.
#
# Preflight (one --harness per invocation):
#   enforce-models --harness pi|hermes|claude|codex|langgraph --model provider/model [...]
#
# Postflight (scans a directory of meta.json files):
#   enforce-models --check-meta <dir> --attestations <json-or-dir>
#                                     [--expect <batch.json|id,...>]
#                                     [--allow-empty] [--strict]
#
# Exit codes:
#   0  all requested models available OR every child's model is proven correct
#   1  postflight gate failure: MODEL DRIFT, or a child whose model cannot be
#      proven at all (ACN shared rule 2 — unprovable is never `validated`)
#   2  usage / preflight failure (missing model)
#
# --expect       the batch's expected child ids, so a child that died before
#                writing any meta is caught. Scanning what is present can
#                never notice a file that was never created.
# --allow-empty  a batch with zero children is a pass, not a gate failure
# --strict       also fail on metas missing schema-required fields
#
# Bypass: BM_SKIP_MODEL_CHECK=1 makes preflight a no-op pass-through.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

python_runtime() {
  if [ -n "${BEASTMODE_PYTHON:-}" ]; then
    printf '%s\n' "$BEASTMODE_PYTHON"
  elif [ -x "$SCRIPT_DIR/../.venv/bin/python" ]; then
    printf '%s\n' "$SCRIPT_DIR/../.venv/bin/python"
  else
    printf '%s\n' python3
  fi
}

usage() {
  cat >&2 <<'USAGE'
usage: enforce-models --harness pi|hermes|claude|codex|langgraph --model provider/model [...]
       enforce-models --check-meta <dir> --attestations <json-or-dir>
                                         [--expect <batch.json|id,...>]
                                         [--allow-empty] [--strict]
USAGE
  exit 2
}

[ $# -ge 1 ] || usage

# ---- arg parse ----
HARNESS=""
MODELS=()
META_DIR=""
META_FLAGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --harness)    HARNESS="${2:-}"; shift 2 ;;
    --harness=*)  HARNESS="${1#*=}"; shift ;;
    --model)      MODELS+=("${2:-}"); shift 2 ;;
    --model=*)    MODELS+=("${1#*=}"); shift ;;
    --check-meta) META_DIR="${2:-}"; shift 2 ;;
    --expect)     META_FLAGS+=(--expect "${2:-}"); shift 2 ;;
    --expect=*)   META_FLAGS+=(--expect "${1#*=}"); shift ;;
    --attestations) META_FLAGS+=(--attestations "${2:-}"); shift 2 ;;
    --attestations=*) META_FLAGS+=(--attestations "${1#*=}"); shift ;;
    --allow-empty) META_FLAGS+=(--allow-empty); shift ;;
    --strict)     META_FLAGS+=(--strict); shift ;;
    -h|--help)    usage ;;
    *)            echo "enforce-models: unknown arg: $1" >&2; usage ;;
  esac
done

# ---- postflight ----
# ponytail: the provenance gate itself lives in scripts/lib/acn_meta.py, which
# scripts/acn-report imports too. Two readings of one contract is how a child
# ends up passing in one tool and failing in the other, so this branch is a
# thin shell over the shared checker rather than a second implementation.
if [ -n "$META_DIR" ]; then
  if [ ! -d "$META_DIR" ]; then
    echo "enforce-models: --check-meta dir not found: $META_DIR" >&2
    exit 2
  fi
  set +e
  python3 "$SCRIPT_DIR/lib/acn_meta.py" --check "$META_DIR" "${META_FLAGS[@]+"${META_FLAGS[@]}"}"
  rc=$?
  set -e
  exit $rc
fi

# ---- preflight ----
[ -n "$HARNESS" ] || usage
[ "${#MODELS[@]}" -gt 0 ] || usage

if [ "${BM_SKIP_MODEL_CHECK:-0}" = "1" ]; then
  exit 0
fi

case "$HARNESS" in
  langgraph)
    PYTHON_BIN="$(python_runtime)"
    if ! "$PYTHON_BIN" -c 'import beastmode, langgraph; from langgraph.checkpoint.sqlite import SqliteSaver; c=SqliteSaver.from_conn_string(":memory:"); s=c.__enter__(); s.setup(); c.__exit__(None,None,None)' >/dev/null 2>&1; then
      echo "enforce-models: langgraph runtime not installed; install with:" >&2
      echo "  $PYTHON_BIN -m pip install -e 'python[langgraph]'" >&2
      exit 2
    fi
    # Model listing is provider-specific.  The graph remains fail-closed via
    # SeatModel metadata and does not pretend a package import proves a seat.
    ;;
  pi)
    if ! command -v pi >/dev/null 2>&1; then
      echo "enforce-models: pi not in PATH; install pi or set BM_SKIP_MODEL_CHECK=1" >&2
      exit 2
    fi
    # Probe once and retain the result. A failed `pi --list-models` is still
    # a preflight failure, not a reason for this script to leak the probe's
    # exit status (especially under `set -euo pipefail`).
    available_models=""
    if ! available_models="$(pi --list-models 2>/dev/null)"; then
      available_models=""
    fi
    missing=()
    for model in "${MODELS[@]}"; do
      [[ "$model" == *"/"* ]] || { missing+=("$model"); continue; }
      provider="${model%%/*}"
      model_id="${model#*/}"
      if ! printf '%s\n' "$available_models" \
           | awk -v p="$provider" -v m="$model_id" \
                 'NR>1 && $1==p && $2==m {found=1} END{exit !found}'; then
        missing+=("$model")
      fi
    done
    if [ "${#missing[@]}" -gt 0 ]; then
      echo "enforce-models: requested model(s) not available for harness=$HARNESS:" >&2
      for m in "${missing[@]}"; do
        echo "  - $m" >&2
      done
      echo >&2
      echo "enforce-models: available models (run 'pi --list-models' for full list):" >&2
      printf '%s\n' "$available_models" \
        | awk 'NR>1 {printf "  %s/%s\n", $1, $2}' >&2 || true
      echo >&2
      echo "enforce-models: pick a different --frontier/--economy/--watcher, override the alias in" >&2
      echo "    \$HOME/.beastmode/tier-aliases.json or \$PWD/.beastmode/tier-aliases.json," >&2
      echo "    or set BM_SKIP_MODEL_CHECK=1 to bypass this check." >&2
      exit 2
    fi
    ;;

  hermes)
    # ponytail: presence check on the configured provider name — never read
    # the contents of auth.json or config.yaml. Both files exist on a
    # configured host; we just need *some* signal that the provider is wired.
    cfg="$HOME/.hermes/config.yaml"
    auth="$HOME/.hermes/auth.json"
    [ -f "$cfg" ] || [ -f "$auth" ] || {
      echo "enforce-models: hermes config not found; requested providers cannot be proven available" >&2
      echo "enforce-models: configure Hermes or set BM_SKIP_MODEL_CHECK=1 explicitly" >&2
      exit 2
    }
    missing=()
    for model in "${MODELS[@]}"; do
      [[ "$model" == *"/"* ]] || { missing+=("$model"); continue; }
      provider="${model%%/*}"
      found=0
      if [ -f "$cfg" ]; then
        # grep only the key (provider name); we don't decode the file contents.
        if awk -v p="$provider" '
            /^[[:space:]]*[A-Za-z0-9._-]+:[[:space:]]*$/ {gsub(/[[:space:]]/,"",$0); sub(/:$/,"",$0); if($0==p){print "HIT"; exit}}
            END{exit !0}' "$cfg" >/dev/null 2>&1; then
          found=1
        fi
      fi
      if [ "$found" -eq 0 ] && [ -f "$auth" ]; then
        # grep the provider key in JSON; never print the file.
        if grep -q "\"$provider\"[[:space:]]*:" "$auth" 2>/dev/null; then
          found=1
        fi
      fi
      [ "$found" -eq 1 ] || missing+=("$model")
    done
    if [ "${#missing[@]}" -gt 0 ]; then
      echo "enforce-models: requested model(s) not available for harness=$HARNESS:" >&2
      for m in "${missing[@]}"; do
        echo "  - $m" >&2
      done
      echo >&2
      echo "enforce-models: set BM_SKIP_MODEL_CHECK=1 to bypass this check." >&2
      exit 2
    fi
    ;;

  claude)
    if ! command -v claude >/dev/null 2>&1; then
      echo "enforce-models: claude not in PATH; install claude or set BM_SKIP_MODEL_CHECK=1" >&2
      exit 2
    fi
    if ! claude --version >/dev/null 2>&1; then
      echo "enforce-models: claude harness unavailable on this host" >&2
      exit 2
    fi
    # ponytail: claude pins its own model namespace; if you want a non-claude
    # model through this harness, you're using the wrong harness. Warn, not
    # fail — the runner will error out if it truly cannot dispatch. Compare
    # the model half only: aliases resolve to provider/model, and bm strips
    # the provider before handing it to the CLI, so `anthropic/claude-opus-4-7`
    # is a correct request and used to warn on every single invocation.
    for model in "${MODELS[@]}"; do
      [[ "${model#*/}" == claude-* ]] || {
        echo "enforce-models: warning: harness=claude but model does not start with claude- ($model)" >&2
      }
    done
    ;;

  codex)
    if ! command -v codex >/dev/null 2>&1; then
      echo "enforce-models: codex not in PATH; install codex or set BM_SKIP_MODEL_CHECK=1" >&2
      exit 2
    fi
    if ! codex --version >/dev/null 2>&1; then
      echo "enforce-models: codex harness unavailable on this host" >&2
      exit 2
    fi
    # codex accepts arbitrary provider/model — pass-through.
    ;;

  *)
    echo "enforce-models: unknown --harness: $HARNESS (expected pi|hermes|claude|codex|langgraph)" >&2
    exit 2
    ;;
esac

exit 0
