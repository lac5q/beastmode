#!/usr/bin/env bash
# bm — beastmode runner. One CLI to start a Beastmode goal from anywhere.
#
# Usage:
#   bm "<goal>"                              # default: local, pi harness, medium autonomy, auto models
#   bm "<goal>" --harness hermes             # Hermes ACN (async parallel sub-agents)
#   bm "<goal>" --harness claude|codex|langgraph # adapters / optional graph runtime
#   bm "<goal>" --gsd                        # force GSD phase gating
#   bm "<goal>" --on <remote-host>           # dispatch to a remote machine
#   bm "<goal>" --frontier sol --thinking medium
#   bm "<goal>" --watcher grok               # cross-family watcher seat
#   bm "<goal>" --limit-fallback grok         # one authorized quota/rate-limit recovery
#   bm "<goal>" --autonomy low|medium|high   # default medium
#   bm "<goal>" --interview full|batched|assumptions|off # goal interview mode
#   bm "<goal>" --claude-subscription       # run Claude seats under Claude Code (needs an anthropic/* --frontier)
#   bm "<goal>" --harness langgraph --executor-command '<child argv>' \
#      --attestor-command /trusted/attest --validator-command /trusted/validate \
#      --reviewer-command /trusted/review
#   bm goal run "<goal>" [flags]             # durable, inspectable, resumable goal
#   bm relay "<task>" [--dir D] [--fable-floor 25] # Fable -> Neon (agy) -> Opus review
#   bm goal runs|inspect|logs|approve|reject|pause|resume|cancel|reconcile
#
# The goal can appear anywhere on the command line; flags are parsed first
# and the remaining args are joined into the goal string.
#
# Model aliases resolved in references/tier-aliases.md (tier model).
# Autonomy levels are defined in references/autonomy-levels.md.
# Shared prompt strings live in scripts/lib/prompts.sh; model
# preflight/postflight in scripts/enforce-models.
#
# Exit code: 0 = goal_complete surfaced; 1 = goal_blocked or watch failure;
# 2 = usage / config error.

set -euo pipefail

# SSH/non-interactive shells do not source a user's login profile. Keep the
# runner deterministic on macOS (Homebrew) and Linux (user-local installs) by
# exposing the standard executable locations before model preflight and
# harness dispatch. This is path discovery only; it never changes credentials
# or permission policy.
for bm_bin_dir in "$HOME/.local/bin" "/opt/homebrew/bin" "/usr/local/bin"; do
  if [ -d "$bm_bin_dir" ]; then
    case ":$PATH:" in
      *":$bm_bin_dir:"*) ;;
      *) PATH="$PATH:$bm_bin_dir" ;;
    esac
  fi
done
export PATH

GSD=0
ON="auto"
HARNESS="pi"
FRONTIER=""
# Keep the economy seat explicit so every harness pins the approved low-cost
# worker instead of inheriting a host/session default. Callers can override it
# with --economy for a deliberate alternate lane.
ECONOMY="luna-max"
# Bare model id behind the `luna-max` alias. The provider-translation guards
# below compare against this so a model bump is a one-line change here plus
# scripts/tier-aliases.json.
LUNA_MODEL="gpt-6-luna"
ECONOMY_EXPLICIT=0
# Keep the input form separate from the resolved provider/model. Hermes uses
# a different authenticated provider namespace for Luna, so a friendly alias
# may be translated while an operator's explicit provider/model must remain
# untouched.
ECONOMY_INPUT_KIND="default"
WORKER_FALLBACK_USED=0
WORKER_FALLBACK_ALIAS=""
WORKER_FALLBACK_FROM=""
WATCHER=""
LIMIT_FALLBACK=""
CLAUDE_SUBSCRIPTION=0
CLAUDE_SUBSCRIPTION_EXPLICIT=0
AUTONOMY="medium"
INTERVIEW=""
THINKING="max"
ECONOMY_THINKING="-"
WATCHER_THINKING="-"
LANGGRAPH_GRAPH="pipeline"
EXECUTOR_COMMAND=""
ATTESTOR_COMMAND=""
VALIDATOR_COMMAND=""
REVIEWER_COMMAND=""
ALLOW_WORKER_NETWORK=0
WORKTREE_ROOT=""
GOAL_PARTS=()
PRINT_HELP=0

# ponytail: aliases live in references/tier-aliases.json — one stdlib json
# lookup beats a 14-line bash case statement, and the file is the source of
# truth the docs reference. Fallback: pass the alias through unchanged so
# `pi` reports the real error instead of us silently mapping wrong.
# Look in the user-global file first, then the shipped file. Repository aliases
# are untrusted by default because a checkout must not be able to downgrade the
# requested model. Set BM_TRUST_REPO_ALIASES=1 only after reviewing that file.
# Resolve the launcher path before deriving sibling files.  On macOS the
# installed `~/.local/bin/bm` is a symlink to this script; using BASH_SOURCE
# directly makes SCRIPT_DIR point at ~/.local/bin and breaks `lib/prompts.sh`.
BM_SOURCE="${BASH_SOURCE[0]}"
while [ -h "$BM_SOURCE" ]; do
  BM_SOURCE_DIR="$(cd -P -- "$(dirname -- "$BM_SOURCE")" && pwd)"
  BM_SOURCE_LINK="$(readlink "$BM_SOURCE")"
  case "$BM_SOURCE_LINK" in
    /*) BM_SOURCE="$BM_SOURCE_LINK" ;;
    *) BM_SOURCE="$BM_SOURCE_DIR/$BM_SOURCE_LINK" ;;
  esac
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$BM_SOURCE")" && pwd)"
SHIP_ALIASES="${SCRIPT_DIR}/tier-aliases.json"

# Optional trusted per-user seat defaults. Checkout-local profiles are never
# discovered here: this file is either the explicit BM_DEFAULTS_FILE or the
# operator's ~/.beastmode/defaults.json. Parse JSON as data and emit only
# validated, delimiter-safe values; never evaluate profile text as shell.
BM_DEFAULTS_EXPLICIT=0
if [ -n "${BM_DEFAULTS_FILE:-}" ]; then
  BM_DEFAULTS_PATH="$BM_DEFAULTS_FILE"
  BM_DEFAULTS_EXPLICIT=1
else
  BM_DEFAULTS_PATH="$HOME/.beastmode/defaults.json"
fi
if [ -f "$BM_DEFAULTS_PATH" ] || [ "$BM_DEFAULTS_EXPLICIT" = "1" ]; then
  if [ ! -f "$BM_DEFAULTS_PATH" ]; then
    echo "bm: defaults profile not found or not a regular file: $BM_DEFAULTS_PATH" >&2
    exit 2
  fi
  if ! BM_DEFAULTS_VALUES="$(python3 - "$BM_DEFAULTS_PATH" <<'PY'
import json
import re
import sys

path = sys.argv[1]
allowed = {
    "schema_version", "harness", "frontier", "economy", "watcher",
    "limit_fallback", "thinking", "claude_subscription_watcher",
    "economy_thinking", "watcher_thinking",
}

def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate key {key!r}")
        result[key] = value
    return result

try:
    with open(path, encoding="utf-8") as handle:
        profile = json.load(handle, object_pairs_hook=unique_object)
except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as exc:
    print(f"bm: invalid defaults profile {path}: {exc}", file=sys.stderr)
    raise SystemExit(2)

if not isinstance(profile, dict):
    print(f"bm: invalid defaults profile {path}: top level must be an object", file=sys.stderr)
    raise SystemExit(2)
unknown = sorted(set(profile) - allowed)
if unknown:
    print(f"bm: invalid defaults profile {path}: unknown field(s): {', '.join(unknown)}", file=sys.stderr)
    raise SystemExit(2)
if type(profile.get("schema_version")) is not int or profile["schema_version"] != 1:
    print(f"bm: invalid defaults profile {path}: schema_version must be 1", file=sys.stderr)
    raise SystemExit(2)

values = []
for field in ("frontier", "economy", "watcher", "limit_fallback"):
    if field not in profile:
        values.append("-")
        continue
    value = profile[field]
    # One provider/model pair, using conservative model-id characters only.
    # This also makes the shell output delimiter-safe and rejects all spacing.
    if not isinstance(value, str) or len(value) > 200 or not re.fullmatch(
        r"[A-Za-z0-9][A-Za-z0-9._:+-]*/[A-Za-z0-9][A-Za-z0-9._:+-]*", value
    ):
        print(f"bm: invalid defaults profile {path}: {field} must be a provider-qualified model id", file=sys.stderr)
        raise SystemExit(2)
    values.append(value)

harness = profile.get("harness")
if "harness" in profile and (
    not isinstance(harness, str) or harness not in {"pi", "hermes", "claude", "codex", "langgraph"}
):
    print(f"bm: invalid defaults profile {path}: harness must be pi|hermes|claude|codex|langgraph", file=sys.stderr)
    raise SystemExit(2)
values.append(harness if "harness" in profile else "-")

thinking = profile.get("thinking")
if "thinking" in profile and (
    not isinstance(thinking, str) or thinking not in {"none", "minimal", "low", "medium", "high", "xhigh", "max"}
):
    print(f"bm: invalid defaults profile {path}: thinking must be none|minimal|low|medium|high|xhigh|max", file=sys.stderr)
    raise SystemExit(2)
values.append(thinking if "thinking" in profile else "-")

for field in ("economy_thinking", "watcher_thinking"):
    effort = profile.get(field)
    if field in profile and (
        not isinstance(effort, str) or effort not in {"none", "minimal", "low", "medium", "high", "xhigh", "max"}
    ):
        print(f"bm: invalid defaults profile {path}: {field} must be none|minimal|low|medium|high|xhigh|max", file=sys.stderr)
        raise SystemExit(2)
    values.append(effort if field in profile else "-")

subscription_watcher = profile.get("claude_subscription_watcher", False)
if type(subscription_watcher) is not bool:
    print(f"bm: invalid defaults profile {path}: claude_subscription_watcher must be a boolean", file=sys.stderr)
    raise SystemExit(2)
values.append("1" if subscription_watcher else "0")
print("|".join(values))
PY
)"; then
    exit 2
  fi
  IFS='|' read -r PROFILE_FRONTIER PROFILE_ECONOMY PROFILE_WATCHER PROFILE_LIMIT_FALLBACK PROFILE_HARNESS PROFILE_THINKING PROFILE_ECONOMY_THINKING PROFILE_WATCHER_THINKING PROFILE_CLAUDE_SUBSCRIPTION_WATCHER <<< "$BM_DEFAULTS_VALUES"
  [ "$PROFILE_FRONTIER" = "-" ] || FRONTIER="$PROFILE_FRONTIER"
  if [ "$PROFILE_ECONOMY" != "-" ]; then
    ECONOMY="$PROFILE_ECONOMY"
    ECONOMY_EXPLICIT=1
    ECONOMY_INPUT_KIND="qualified"
  fi
  [ "$PROFILE_WATCHER" = "-" ] || WATCHER="$PROFILE_WATCHER"
  [ "$PROFILE_LIMIT_FALLBACK" = "-" ] || LIMIT_FALLBACK="$PROFILE_LIMIT_FALLBACK"
  [ "$PROFILE_HARNESS" = "-" ] || HARNESS="$PROFILE_HARNESS"
  [ "$PROFILE_THINKING" = "-" ] || THINKING="$PROFILE_THINKING"
  ECONOMY_THINKING="$PROFILE_ECONOMY_THINKING"
  WATCHER_THINKING="$PROFILE_WATCHER_THINKING"
else
  PROFILE_CLAUDE_SUBSCRIPTION_WATCHER=0
fi

# ---------------------------------------------------------------------------
# Beastmode self-management. Delegate the lifecycle verbs to the installer
# that ships next to `bm` (same snapshot). These are reserved only when they
# are the very first token, so a goal can never be hijacked by them.
# ---------------------------------------------------------------------------
case "${1:-}" in
  install|upgrade|uninstall|status|doctor|version)
    BM_INSTALLER="$SCRIPT_DIR/install-beastmode.sh"
    if [ ! -x "$BM_INSTALLER" ]; then
      echo "bm: missing $BM_INSTALLER (is this a partial checkout?)" >&2
      exit 2
    fi
    BM_CMD="$1"; shift
    exec "$BM_INSTALLER" "$BM_CMD" "$@"
    ;;
  relay)
    # Three fresh sessions: Fable architects (Opus high below the Fable
    # floor), Neon via agy makes it better, Opus reviews. See scripts/bm-relay.
    BM_RELAY="$SCRIPT_DIR/bm-relay"
    if [ ! -x "$BM_RELAY" ]; then
      echo "bm: missing $BM_RELAY (is this a partial checkout?)" >&2
      exit 2
    fi
    shift
    exec python3 "$BM_RELAY" "$@"
    ;;
  goal)
    # Native goal lifecycle (schema/goal-lifecycle.json). Namespaced under
    # `goal` so a goal whose text starts with "inspect" or "run" is never
    # hijacked; only `bm goal <known verb>` is reserved.
    case "${2:-}" in
      run|runs|inspect|logs|approve|reject|pause|resume|cancel|reconcile|schedule|capabilities|help|-h|--help|"")
        BM_GOAL="$SCRIPT_DIR/bm-goal"
        if [ ! -x "$BM_GOAL" ]; then
          echo "bm: missing $BM_GOAL (is this a partial checkout?)" >&2
          exit 2
        fi
        shift
        exec python3 "$BM_GOAL" "$@"
        ;;
    esac
    ;;
esac

resolve_alias() {
  local alias="$1"
  [ -z "$alias" ] && { echo ""; return; }
  # Already a provider/model → pass through.
  [[ "$alias" == *"/"* ]] && { echo "$alias"; return; }

  local repo_aliases="$PWD/.beastmode/tier-aliases.json"
  local user_aliases="$HOME/.beastmode/tier-aliases.json"
  local candidates=("$user_aliases" "$SHIP_ALIASES")
  case "${BM_TRUST_REPO_ALIASES:-0}" in
    0|"") ;;
    1) candidates=("$repo_aliases" "${candidates[@]}") ;;
    *)
      echo "bm: BM_TRUST_REPO_ALIASES must be 0 or 1" >&2
      return 2
      ;;
  esac
  for f in "${candidates[@]}"; do
    [ -f "$f" ] || continue
    local hit
    if ! hit="$(python3 - "$f" "$alias" <<'PY'
import json
import sys

path, alias = sys.argv[1:]
try:
    with open(path, encoding="utf-8") as handle:
        data = json.load(handle)
except (OSError, json.JSONDecodeError) as exc:
    print(f"bm: invalid alias file {path}: {exc}", file=sys.stderr)
    raise SystemExit(2)

entry = data.get(alias)
if entry is None:
    raise SystemExit(0)
if not isinstance(entry, dict):
    print(f"bm: alias {alias!r} in {path} must be an object", file=sys.stderr)
    raise SystemExit(2)
provider = entry.get("provider")
model = entry.get("model")
if not all(isinstance(value, str) and value and len(value) <= 200 for value in (provider, model)):
    print(f"bm: alias {alias!r} in {path} needs non-empty provider and model strings", file=sys.stderr)
    raise SystemExit(2)
if "/" in provider or any(ord(char) < 32 for value in (provider, model) for char in value):
    print(f"bm: alias {alias!r} in {path} contains unsafe provider/model characters", file=sys.stderr)
    raise SystemExit(2)
print(f"{provider}/{model}")
PY
)"; then
      return 2
    fi
    [ -n "$hit" ] && { echo "$hit"; return; }
  done
  echo "bm: unknown model alias '$alias'; use a reviewed alias or provider/model" >&2
  return 2
}

usage() {
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

if [ $# -eq 0 ]; then
  usage
fi

# First pass: collect flags and non-flag args separately.
while [ $# -gt 0 ]; do
  case "$1" in
    --gsd)             GSD=1; shift ;;
    --harness)         HARNESS="${2:-pi}"; shift 2 ;;
    --harness=*)       HARNESS="${1#*=}"; shift ;;
    --on)              ON="${2:-auto}"; shift 2 ;;
    --on=*)            ON="${1#*=}"; shift ;;
    --frontier)        FRONTIER="${2:-}"; shift 2 ;;
    --frontier=*)      FRONTIER="${1#*=}"; shift ;;
    --economy)
      ECONOMY="${2:-}"
      ECONOMY_EXPLICIT=1
      [[ "$ECONOMY" == */* ]] && ECONOMY_INPUT_KIND="qualified" || ECONOMY_INPUT_KIND="friendly"
      shift 2
      ;;
    --economy=*)
      ECONOMY="${1#*=}"
      ECONOMY_EXPLICIT=1
      [[ "$ECONOMY" == */* ]] && ECONOMY_INPUT_KIND="qualified" || ECONOMY_INPUT_KIND="friendly"
      shift
      ;;
    --watcher)         WATCHER="${2:-}"; shift 2 ;;
    --watcher=*)       WATCHER="${1#*=}"; shift ;;
    --limit-fallback)
      if [ $# -lt 2 ] || [ -z "$2" ]; then
        echo "bm: --limit-fallback needs an alias or provider/model" >&2
        exit 2
      fi
      LIMIT_FALLBACK="$2"
      shift 2
      ;;
    --limit-fallback=*)
      LIMIT_FALLBACK="${1#*=}"
      if [ -z "$LIMIT_FALLBACK" ]; then
        echo "bm: --limit-fallback needs an alias or provider/model" >&2
        exit 2
      fi
      shift
      ;;
    --claude-subscription) CLAUDE_SUBSCRIPTION=1; CLAUDE_SUBSCRIPTION_EXPLICIT=1; shift ;;
    --graph)           LANGGRAPH_GRAPH="${2:-pipeline}"; shift 2 ;;
    --graph=*)         LANGGRAPH_GRAPH="${1#*=}"; shift ;;
    --executor-command) EXECUTOR_COMMAND="${2:-}"; shift 2 ;;
    --executor-command=*) EXECUTOR_COMMAND="${1#*=}"; shift ;;
    --attestor-command) ATTESTOR_COMMAND="${2:-}"; shift 2 ;;
    --attestor-command=*) ATTESTOR_COMMAND="${1#*=}"; shift ;;
    --validator-command) VALIDATOR_COMMAND="${2:-}"; shift 2 ;;
    --validator-command=*) VALIDATOR_COMMAND="${1#*=}"; shift ;;
    --reviewer-command) REVIEWER_COMMAND="${2:-}"; shift 2 ;;
    --reviewer-command=*) REVIEWER_COMMAND="${1#*=}"; shift ;;
    --allow-worker-network) ALLOW_WORKER_NETWORK=1; shift ;;
    --worktree-root)   WORKTREE_ROOT="${2:-}"; shift 2 ;;
    --worktree-root=*) WORKTREE_ROOT="${1#*=}"; shift ;;
    --autonomy)        AUTONOMY="${2:-medium}"; shift 2 ;;
    --autonomy=*)      AUTONOMY="${1#*=}"; shift ;;
    --interview)       INTERVIEW="${2:-}"; shift 2 ;;
    --interview=*)     INTERVIEW="${1#*=}"; shift ;;
    --thinking)        THINKING="${2:-max}"; shift 2 ;;
    --thinking=*)      THINKING="${1#*=}"; shift ;;
    --economy-thinking)    ECONOMY_THINKING="${2:-}"; shift 2 ;;
    --economy-thinking=*)  ECONOMY_THINKING="${1#*=}"; shift ;;
    --watcher-thinking)    WATCHER_THINKING="${2:-}"; shift 2 ;;
    --watcher-thinking=*)  WATCHER_THINKING="${1#*=}"; shift ;;
    -h|--help)         PRINT_HELP=1; shift ;;
    --)                shift; while [ $# -gt 0 ]; do GOAL_PARTS+=("$1"); shift; done ;;
    -*)                echo "bm: unknown arg: $1" >&2; usage ;;
    *)                 GOAL_PARTS+=("$1"); shift ;;
  esac
done

if [ "$PRINT_HELP" = "1" ]; then
  usage
fi

case "$AUTONOMY" in
  low|medium|high) ;;
  *) echo "bm: --autonomy must be low|medium|high (got: $AUTONOMY)" >&2; exit 2 ;;
esac

if [ -z "$INTERVIEW" ]; then
  case "$AUTONOMY" in
    low) INTERVIEW_MODE="full" ;;
    medium|high) INTERVIEW_MODE="batched" ;;
  esac
else
  INTERVIEW_MODE="$INTERVIEW"
fi
case "$INTERVIEW_MODE" in
  full|batched|assumptions|off) ;;
  *) echo "bm: --interview must be full|batched|assumptions|off (got: $INTERVIEW_MODE)" >&2; exit 2 ;;
esac

case "$HARNESS" in
  pi|hermes|claude|codex|langgraph) ;;
  *) echo "bm: --harness must be pi|hermes|claude|codex|langgraph (got: $HARNESS)" >&2; exit 2 ;;
esac

if [ "$HARNESS" = "langgraph" ] && [ "$LANGGRAPH_GRAPH" != "pipeline" ]; then
  echo "bm: --graph must be pipeline for the LangGraph harness" >&2
  exit 2
fi

case "$THINKING" in
  none|minimal|low|medium|high|xhigh|max) ;;
  *) echo "bm: --thinking must be none|minimal|low|medium|high|xhigh|max (got: $THINKING)" >&2; exit 2 ;;
esac

for _t in "economy-thinking:$ECONOMY_THINKING" "watcher-thinking:$WATCHER_THINKING"; do
  case "${_t#*:}" in
    -|none|minimal|low|medium|high|xhigh|max) ;;
    *) echo "bm: --${_t%%:*} must be none|minimal|low|medium|high|xhigh|max (got: ${_t#*:})" >&2; exit 2 ;;
  esac
done

GOAL="${GOAL_PARTS[*]:-}"
[ -z "$GOAL" ] && usage

# Resolve aliases after parsing so the help path stays side-effect free.
if [ -n "$FRONTIER" ] && ! FRONTIER="$(resolve_alias "$FRONTIER")"; then exit 2; fi
if [ -n "$ECONOMY" ] && ! ECONOMY="$(resolve_alias "$ECONOMY")"; then exit 2; fi
# Hermes names its authenticated Luna provider `vibeproxy`, while Pi/Codex
# use the `openai-codex` namespace. Translate the implicit default and
# friendly aliases so the request remains model-pinned without rewriting an
# operator's explicit provider/model override. A qualified input remains
# explicit.
if [ "$HARNESS" = "hermes" ] && [ "$ECONOMY_INPUT_KIND" != "qualified" ] \
  && [ "$ECONOMY" = "openai-codex/$LUNA_MODEL" ]; then
  ECONOMY="vibeproxy/$LUNA_MODEL"
fi
# Pi hosts in this fleet have the managed pi-vibeproxy extension.  Its
# OpenAI-compatible Chat Completions route is reachable from Main-Mac and
# Maeve, while the ChatGPT Responses endpoint used by openai-codex can hang
# behind those hosts' egress path.  Keep the model pin (GPT-6 Luna, max
# reasoning) but use the reachable provider for the implicit/friendly worker
# seat.  A qualified provider/model remains an explicit operator choice.
if [ "$HARNESS" = "pi" ] && [ "$ECONOMY_INPUT_KIND" != "qualified" ] \
  && [ "$ECONOMY" = "openai-codex/$LUNA_MODEL" ]; then
  PI_LUNA_PROVIDER="${BM_PI_LUNA_PROVIDER:-vibeproxy}"
  case "$PI_LUNA_PROVIDER" in
    vibeproxy|openai-codex) ;;
    *)
      echo "bm: BM_PI_LUNA_PROVIDER must be vibeproxy or openai-codex (got: $PI_LUNA_PROVIDER)" >&2
      exit 2
      ;;
  esac
  ECONOMY="$PI_LUNA_PROVIDER/$LUNA_MODEL"
fi

# If the implicit economy seat is unavailable, prefer a live configured
# economy provider and then use a lower Anthropic model for an Anthropic
# director. This is deliberately limited to the built-in/default worker seat:
# an explicit --economy or trusted profile selection remains fail-closed.
# Claude Code has no portable model-listing command, so its Anthropic lane
# selects haiku unless BM_CLAUDE_WORKER_MODEL asks for a reviewed alternate.
worker_model_is_available() {
  local available="$1" requested="$2"
  local provider="${requested%%/*}" model_id="${requested#*/}"
  [ -n "$provider" ] && [ -n "$model_id" ] || return 1
  printf '%s\n' "$available" \
    | awk -v p="$provider" -v m="$model_id" \
      'NR>1 && $1==p && $2==m {found=1} END{exit !found}'
}

worker_fallback_aliases() {
  # Checkout-local aliases are untrusted unless BM_TRUST_REPO_ALIASES is
  # explicitly set, and an automatic worker lane must never inherit that
  # trust implicitly.
  local -a alias_files=("$HOME/.beastmode/tier-aliases.json" "$SHIP_ALIASES")
  if [ "${BM_TRUST_REPO_ALIASES:-0}" = "1" ]; then
    alias_files=("$PWD/.beastmode/tier-aliases.json" "${alias_files[@]}")
  fi
  python3 - "${alias_files[@]}" <<'PY'
import json
import os
import sys

seen = set()
for path in sys.argv[1:]:
    if not os.path.isfile(path):
        continue
    try:
        with open(path, encoding="utf-8") as handle:
            aliases = json.load(handle)
    except (OSError, UnicodeError, json.JSONDecodeError):
        continue
    if not isinstance(aliases, dict):
        continue
    for alias, entry in aliases.items():
        if alias in seen or not isinstance(entry, dict):
            continue
        if entry.get("worker_fallback") is not True:
            continue
        if entry.get("tier") != "economy" or entry.get("family") == "anthropic":
            continue
        seen.add(alias)
        print(alias)
PY
}

select_worker_fallback() {
  [ "$ECONOMY_INPUT_KIND" = "default" ] || return 0
  [ "$CLAUDE_SUBSCRIPTION_EXPLICIT" = "0" ] || return 0
  [[ "$FRONTIER" == anthropic/* ]] || return 0

  local original_economy="$ECONOMY"
  local candidate alias available
  local -a external_candidates=()
  local -a anthropic_candidates=(haiku sonnet-worker)

  # The Claude Code subscription lane is the only available provider in this
  # mode. Keep the choice constrained to reviewed Anthropic aliases.
  if [ "$HARNESS" = "claude" ]; then
    alias="${BM_CLAUDE_WORKER_MODEL:-haiku}"
    case "$alias" in
      haiku|sonnet-worker|sonnet|sonnet5) ;;
      *)
        echo "bm: BM_CLAUDE_WORKER_MODEL must be haiku|sonnet-worker|sonnet|sonnet5 (got: $alias)" >&2
        exit 2
        ;;
    esac
    candidate="$(resolve_alias "$alias")"
    ECONOMY="$candidate"
    WORKER_FALLBACK_USED=1
    WORKER_FALLBACK_ALIAS="$alias"
    WORKER_FALLBACK_FROM="$original_economy"
    echo "bm: default economy seat $original_economy is unavailable on the Claude harness; using Anthropic worker fallback $candidate" >&2
    return 0
  fi

  # Pi is the only local harness with a portable model listing. If it cannot
  # be queried, retain the normal fail-closed preflight behavior.
  command -v pi >/dev/null 2>&1 || return 0
  available="$(pi --list-models 2>/dev/null || true)"
  worker_model_is_available "$available" "$ECONOMY" && return 0

  # A live non-Anthropic economy lane wins before same-provider degradation.
  # A candidate must be explicitly marked worker_fallback in a trusted alias
  # file; this excludes known-drift/manual lanes such as gemini-flash.
  mapfile -t external_candidates < <(worker_fallback_aliases || true)
  for alias in "${external_candidates[@]}"; do
    if ! candidate="$(resolve_alias "$alias")"; then
      continue
    fi
    [[ "$candidate" == anthropic/* ]] && continue
    if worker_model_is_available "$available" "$candidate"; then
      ECONOMY="$candidate"
      WORKER_FALLBACK_USED=1
      WORKER_FALLBACK_ALIAS="$alias"
      WORKER_FALLBACK_FROM="$original_economy"
      echo "bm: default economy seat $original_economy is unavailable; using live economy worker $candidate" >&2
      return 0
    fi
  done

  # No other provider is live, so use the lower Anthropic family lane.
  for alias in "${anthropic_candidates[@]}"; do
    if ! candidate="$(resolve_alias "$alias")"; then
      continue
    fi
    if worker_model_is_available "$available" "$candidate"; then
      ECONOMY="$candidate"
      WORKER_FALLBACK_USED=1
      WORKER_FALLBACK_ALIAS="$alias"
      WORKER_FALLBACK_FROM="$original_economy"
      echo "bm: default economy seat $original_economy is unavailable and no other economy provider is live; using Anthropic worker fallback $candidate" >&2
      return 0
    fi
  done
}

select_worker_fallback
if [ -n "$WATCHER" ] && ! WATCHER="$(resolve_alias "$WATCHER")"; then exit 2; fi
if [ -n "$LIMIT_FALLBACK" ]; then
  if ! LIMIT_FALLBACK="$(resolve_alias "$LIMIT_FALLBACK")"; then exit 2; fi
  if [ "${#LIMIT_FALLBACK}" -gt 200 ] || \
    ! [[ "$LIMIT_FALLBACK" =~ ^[A-Za-z0-9][A-Za-z0-9._:+-]*/[A-Za-z0-9][A-Za-z0-9._:+-]*$ ]]; then
    echo "bm: --limit-fallback must resolve to a provider-qualified model ID" >&2
    exit 2
  fi
fi

# Keep the legacy Grok 4.5 budget guard for explicitly selected 4.5 seats.
# The shipped `grok` alias now targets 4.7; this guard does not affect Grok
# 4.7 or the separately selected `limit_fallback`.
# Grok is a deliberately budgeted frontier lane.  There is no portable
# provider API for a weekly remaining percentage, so the operator can expose
# the latest dashboard reading as BEASTMODE_GROK_WEEKLY_REMAINING_PCT.  Fail
# closed when it is absent: an explicit Grok seat is replaced with the pinned
# Luna Max economy model unless we can prove at least the 40% weekly floor.
# This keeps a stale or unavailable quota dashboard from silently burning the
# remaining Grok allowance.
GROK_MIN_WEEKLY_REMAINING_PCT=40
GROK_READING_AT="${BEASTMODE_GROK_WEEKLY_REMAINING_AT:-}"
GROK_WEEKLY_REMAINING_PCT="${BEASTMODE_GROK_WEEKLY_REMAINING_PCT:-}"
if [ "${BEASTMODE_GROK_MIN_WEEKLY_REMAINING_PCT:-40}" != "40" ]; then
  echo "bm: the Grok weekly budget floor is fixed at 40%" >&2
  exit 2
fi
if [ -n "$GROK_WEEKLY_REMAINING_PCT" ] && \
  { ! [[ "$GROK_WEEKLY_REMAINING_PCT" =~ ^[0-9]+([.][0-9]+)?$ ]] || \
    ! awk -v value="$GROK_WEEKLY_REMAINING_PCT" 'BEGIN { exit !(value >= 0 && value <= 100) }'; }; then
  echo "bm: BEASTMODE_GROK_WEEKLY_REMAINING_PCT must be a number from 0 to 100" >&2
  exit 2
fi
if [[ "$FRONTIER" == xai/grok-4.5 || "$ECONOMY" == xai/grok-4.5 || "$WATCHER" == xai/grok-4.5 ]]; then
  grok_budget_ok=0
  if [ -n "$GROK_WEEKLY_REMAINING_PCT" ] && \
    awk -v remaining="$GROK_WEEKLY_REMAINING_PCT" -v minimum="$GROK_MIN_WEEKLY_REMAINING_PCT" \
      -v observed="$GROK_READING_AT" -v now="$(date +%s)" \
      'BEGIN { exit !(observed ~ /^[0-9]+$/ && observed <= now && now - observed <= 604800 && remaining >= minimum) }'; then
    grok_budget_ok=1
  fi
  if [ "$grok_budget_ok" -eq 0 ]; then
    LUNA_BUDGET_MODEL="$(resolve_alias "luna-max")"
    echo "bm: Grok weekly budget is below ${GROK_MIN_WEEKLY_REMAINING_PCT}% or unverified/stale; switching every Grok seat to ${LUNA_BUDGET_MODEL}" >&2
    [ "$FRONTIER" = "xai/grok-4.5" ] && FRONTIER="$LUNA_BUDGET_MODEL"
    [ "$ECONOMY" = "xai/grok-4.5" ] && ECONOMY="$LUNA_BUDGET_MODEL"
    [ "$WATCHER" = "xai/grok-4.5" ] && WATCHER="$LUNA_BUDGET_MODEL"
  fi
fi

# claude_subscription_watcher is still parsed for old profiles but does nothing:
# a subscription watcher through a third-party harness is not permitted.

# Anthropic directors on the default Pi or Claude harness use the documented
# read-only subscription wrapper. Explicit other harnesses retain their
# dispatch contract and still pass through the OAuth breaker below.
if [ "$CLAUDE_SUBSCRIPTION" = "0" ]; then
  case "$HARNESS:${FRONTIER:-$ECONOMY}" in
    pi:anthropic/*|claude:anthropic/*)
      HARNESS=claude
      CLAUDE_SUBSCRIPTION=1
      if [ -z "$FRONTIER" ]; then
        FRONTIER="$ECONOMY"
        ECONOMY=""
      fi
      ;;
  esac
fi

# --claude-subscription (and the automatic Anthropic-director route) runs only
# inside Claude Code, so under --harness claude any number of Claude seats
# (director, economy, optionally watcher) is fine: they are all first-party use.
# Other harnesses are rejected. A pinned frontier is still required.
if [ "$CLAUDE_SUBSCRIPTION" = "1" ]; then
  if [ "$HARNESS" != "claude" ]; then
    echo "bm: --claude-subscription requires --harness claude" >&2
    exit 2
  fi
  if [ -z "$FRONTIER" ]; then
    echo "bm: --claude-subscription requires --frontier fable|opus|opus5 to pin the director model" >&2
    exit 2
  fi
  case "$FRONTIER" in
    anthropic/*) ;;
    *) echo "bm: --claude-subscription requires --frontier to be an anthropic/* model (a Claude director)" >&2; exit 2 ;;
  esac
fi

# Circuit breaker: Claude models run only inside Claude Code (--harness claude).
# On any other harness (pi/hermes/codex/langgraph) a Claude seat is allowed only
# with a real ANTHROPIC_API_KEY (billed API use). Subscription login through a
# third-party tool is blocked outright: no prompt, and BM_ALLOW_CLAUDE_OAUTH
# does not override it. The old profile-watcher exception is gone because it only
# ever applied to non-claude harnesses, which is exactly what this blocks.
CLAUDE_SEAT_ANY=0
# LIMIT_FALLBACK is resolved above; it and anything forwarded via --on count too.
for seat in "$FRONTIER" "$ECONOMY" "$WATCHER" "$LIMIT_FALLBACK"; do
  [ -z "$seat" ] && continue
  case "$seat" in
    anthropic/*|*claude*) CLAUDE_SEAT_ANY=1 ;;
    *) continue ;;
  esac
  [ -n "${ANTHROPIC_API_KEY:-}" ] && continue          # API-key billing: fine
  [ "$HARNESS" = "claude" ] && continue                # first-party Claude Code use
  echo "bm: BREAKER: blocked Claude seat '$seat' on subscription login through --harness $HARNESS: that routes subscription credentials through a non-Anthropic tool, which Anthropic terms do not permit. Run Claude seats with --harness claude (Claude Code), or set ANTHROPIC_API_KEY for billed API use." >&2
  exit 3
done

case "$HARNESS" in
  codex|hermes)
    if [ -z "$FRONTIER" ]; then
      echo "bm: --harness $HARNESS requires --frontier <alias|provider/model> so the model is pinned" >&2
      exit 2
    fi ;;
esac

# Resolve --on auto: prefer remote if BM_AUTO_TARGET is set, else local.
if [ "$ON" = "auto" ]; then
  ON="${BM_AUTO_TARGET:-local}"
fi
if [ "$ON" = "local" ] && [ "$HARNESS" = "langgraph" ] && [ -n "$LIMIT_FALLBACK" ]; then
  echo "bm: --limit-fallback is not supported by the local LangGraph runner, which does not consume the shared seat prompt" >&2
  exit 2
fi

if [ "$ON" = "local" ] && [ "$HARNESS" = "langgraph" ] && { [ "$ECONOMY_THINKING" != "-" ] || [ "$WATCHER_THINKING" != "-" ]; }; then
  echo "bm: --economy-thinking/--watcher-thinking are not supported by the local LangGraph runner, which does not consume the shared seat prompt" >&2
  exit 2
fi

# ponytail: a goal is the only input before design. Print a transparent rough
# baseline now; replace it with measured phase history when that exists.
python3 "$SCRIPT_DIR/phase-estimate" "$GOAL"

# Shared prompt library (extracted from this script in v2.2). Source, not exec.
# shellcheck source=lib/prompts.sh
. "$SCRIPT_DIR/lib/prompts.sh"

# ponytail: validate resolved aliases BEFORE spawning the agent, per harness.
# enforce-models checks pi against `pi --list-models`, hermes against the
# configured providers, claude/codex against CLI presence. Exit 2 with
# alternatives instead of letting the harness crash mid-goal. Skip with
# BM_SKIP_MODEL_CHECK=1 (CI / scripted runs) or for remote dispatch.
if [ "$ON" = "local" ] && [ "${BM_SKIP_MODEL_CHECK:-0}" != "1" ]; then
  ENF_ARGS=(--harness "$HARNESS")
  for model in "$FRONTIER" "$ECONOMY" "$WATCHER"; do
    [ -z "$model" ] && continue
    [[ "$model" != *"/"* ]] && continue  # bare alias w/ no resolution
    ENF_ARGS+=(--model "$model")
  done
  if [ "${#ENF_ARGS[@]}" -gt 2 ]; then
    "$SCRIPT_DIR/enforce-models" "${ENF_ARGS[@]}"
  fi
fi

# Build harness arguments once (used in local run).
PHASE_PROMPT="$(bm_phase_prompt)"
MODEL_FAILURE_PROMPT="$(bm_model_failure_prompt "$AUTONOMY")"
GATE_PROMPT="$(bm_gate_prompt "$AUTONOMY")"
INTERVIEW_PROMPT=""
[ "$INTERVIEW_MODE" != "off" ] && INTERVIEW_PROMPT="$(bm_interview_prompt "$INTERVIEW_MODE")"
[ "$GSD" = "1" ] && PHASE_PROMPT="Use GSD phase gating: gsd-plan-phase, gsd-execute-phase, gsd-verify-work, gsd-ship. $PHASE_PROMPT"
SEAT_PROMPT="Seats: director=$FRONTIER economy=$ECONOMY watcher=${WATCHER:-unset} limit-fallback=${LIMIT_FALLBACK:-unset}. Pin the executor model on every child; never let economy work inherit a session default. Each child returns meta.json with requested_model and actual_model."
if [ "$WORKER_FALLBACK_USED" = "1" ]; then
  SEAT_PROMPT="$SEAT_PROMPT Worker routing: the implicit economy seat $WORKER_FALLBACK_FROM was unavailable, so use the reviewed fallback $ECONOMY for worker tasks. Keep the frontier director on $FRONTIER. Preserve requested_model=$ECONOMY and the provider-reported actual_model in each child receipt."
  if [[ "$ECONOMY" == anthropic/* ]]; then
    if [ "$HARNESS" = "claude" ]; then
      SEAT_PROMPT="$SEAT_PROMPT For Claude Task workers, pass model=${WORKER_FALLBACK_ALIAS} explicitly on every worker invocation; do not let workers inherit the director model."
    else
      SEAT_PROMPT="$SEAT_PROMPT For Anthropic worker tasks, pass model=${WORKER_FALLBACK_ALIAS} explicitly through the selected harness; do not let workers inherit the director model."
    fi
  else
    SEAT_PROMPT="$SEAT_PROMPT Use the selected external economy lane for workers; do not substitute a Claude Task worker for this provider-qualified seat."
  fi
fi
if [ -n "$LIMIT_FALLBACK" ]; then
  SEAT_PROMPT="$SEAT_PROMPT Only a recorded provider quota/rate-limit failure authorizes one agent-level retry of the same bounded contract with $LIMIT_FALLBACK. Preserve the original failure and requested_model/actual_model receipts for both attempts; if the fallback is also limited, report failure. Authentication or network errors, missing provenance, unsupported models, invalid output, and other failures do not authorize fallback. This is routing guidance only; bm does not automatically retry provider subprocesses."
else
  SEAT_PROMPT="$SEAT_PROMPT No fallback is authorized when unset; preserve explicit seat failure behavior and report the failure."
fi
if [ "$WATCHER" = "xai/grok-4.7" ] || [ "$LIMIT_FALLBACK" = "xai/grok-4.7" ]; then
  SEAT_PROMPT="$SEAT_PROMPT For Grok 4.7 validator/fallback work, use the first-party Grok CLI through bin/beast-validator with model grok-4.7 and effort xhigh; require modelUsage evidence of the served model. If the native lane or provenance is unavailable, report failure and do not substitute."
fi
[ "$ECONOMY_THINKING" = "-" ] || SEAT_PROMPT="$SEAT_PROMPT Run economy workers at reasoning effort $ECONOMY_THINKING."
[ "$WATCHER_THINKING" = "-" ] || SEAT_PROMPT="$SEAT_PROMPT Run the watcher at reasoning effort $WATCHER_THINKING."
if [ "$HARNESS" = "claude" ] && [[ "$ECONOMY" == anthropic/?* ]]; then
  SEAT_PROMPT="$SEAT_PROMPT Claude Code workers: pass model=${ECONOMY#*/} explicitly on every Task subagent and every \`claude -p --model ${ECONOMY#*/}\`; never inherit the director model."
fi
if [ "$HARNESS" != "claude" ] && [ "$CLAUDE_SEAT_ANY" = "1" ]; then
  SEAT_PROMPT="$SEAT_PROMPT Claude seats on this harness must authenticate with ANTHROPIC_API_KEY (billed API); never use a Claude subscription login. If API auth is unavailable, fail."
fi
# Under `bm goal run` the supervisor exports BM_RUN_DIR; the director then
# writes receipts and durable gate/review handshakes there instead of
# reporting them only in the transcript.
LIFECYCLE_PROMPT=""
if [ -n "${BM_RUN_DIR:-}" ] && [ "$HARNESS" != "langgraph" ]; then
  LIFECYCLE_PROMPT="$(bm_lifecycle_prompt "$BM_RUN_DIR" "${BM_GOAL_ID:-unknown}" "${BM_ATTEMPT_ID:-a1}")"
  SEAT_PROMPT="$SEAT_PROMPT $LIFECYCLE_PROMPT"
fi
# Headless Beastmode must explicitly trust the project-local skill and policy
# on every run.  This is a trust/loading invariant, not a permission bypass;
# the canonical project policy still governs tools, paths, and bash commands.
PI_ARGS=(--approve --skill ~/.agents/skills/beastmode-pi/SKILL.md --print --no-session --thinking "$THINKING" --append-system-prompt "$PHASE_PROMPT $MODEL_FAILURE_PROMPT $GATE_PROMPT $INTERVIEW_PROMPT $SEAT_PROMPT")
if [ -n "$FRONTIER" ]; then
  PI_ARGS+=(--model "$FRONTIER")
elif [ -n "$ECONOMY" ]; then
  PI_ARGS+=(--model "$ECONOMY")
else
  # Pin the unqualified Beastmode path to the approved cheap worker.
  PI_ARGS+=(--model "openai-codex/$LUNA_MODEL")
fi
# ponytail: build the --models list from the seats that were actually set.
# `--models "$FRONTIER,$ECONOMY"` handed pi a leading comma whenever --economy
# was given without --frontier, which is a legal invocation.
MODELS_CSV=""
for seat_model in "$FRONTIER" "$ECONOMY"; do
  [ -z "$seat_model" ] && continue
  MODELS_CSV="${MODELS_CSV:+$MODELS_CSV,}$seat_model"
done
[ -n "$ECONOMY" ]      && PI_ARGS+=(--models "$MODELS_CSV")
# High autonomy advances workflow gates without removing implementation tools.
# The required project permission policy still governs writes, edits, and shell
# commands; autonomy never bypasses that policy.

# Claude models run only inside Claude Code. Any non-claude harness (and its
# --on remote command) runs with Claude subscription credentials stripped;
# ANTHROPIC_API_KEY is deliberately left alone.
SCRUB_ENV=()
if [ "$HARNESS" != "claude" ]; then
  SCRUB_ENV=(env -u CLAUDE_CODE_OAUTH_TOKEN -u CLAUDE_CODE_OAUTH_REFRESH_TOKEN)
  while IFS= read -r _v; do
    case "$_v" in CLAUDE_CODE_OAUTH_TOKEN|CLAUDE_CODE_OAUTH_REFRESH_TOKEN) ;; *) SCRUB_ENV+=(-u "$_v") ;; esac
  done < <(compgen -e | grep -E '^CLAUDE_CODE_OAUTH[A-Za-z0-9_]*$' || true)
fi

# Remote dispatch: hand the goal to the selected remote host over SSH and tail the goal log.
# ponytail: foreground SSH so the user sees the live goal stream. If they want
# fire-and-forget, run `bm --on $ON ... &` themselves or use --autonomy high.
if [ "$ON" != "local" ]; then
  if ! command -v ssh >/dev/null 2>&1; then
    echo "bm: --on $ON needs ssh in PATH" >&2; exit 2
  fi
  if [[ ! "$ON" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "bm: --on must be a host alias or hostname, not an ssh option" >&2
    exit 2
  fi
  # ponytail: everything crossing the ssh boundary gets single-quoted with
  # embedded quotes escaped. The old form spliced the raw goal into
  # `bm '$GOAL' ...`, so any apostrophe ("don't drop the index") ended the
  # quote and the rest of the goal was executed as remote shell words.
  # POSIX single-quoting rather than printf %q — %q can emit bash-only
  # $'...' forms and the remote login shell is not guaranteed to be bash.
  shquote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
  REMOTE_CMD="bm $(shquote "$GOAL")"
  [ "$GSD" = "1" ]   && REMOTE_CMD="$REMOTE_CMD --gsd"
  REMOTE_CMD="$REMOTE_CMD --harness $(shquote "$HARNESS")"
  [ "$CLAUDE_SUBSCRIPTION" = "1" ] && REMOTE_CMD="$REMOTE_CMD --claude-subscription"
  [ -n "$FRONTIER" ] && REMOTE_CMD="$REMOTE_CMD --frontier $(shquote "$FRONTIER")"
  [ -n "$ECONOMY" ]  && REMOTE_CMD="$REMOTE_CMD --economy $(shquote "$ECONOMY")"
  [ -n "$WATCHER" ]  && REMOTE_CMD="$REMOTE_CMD --watcher $(shquote "$WATCHER")"
  [ -n "$LIMIT_FALLBACK" ] && REMOTE_CMD="$REMOTE_CMD --limit-fallback $(shquote "$LIMIT_FALLBACK")"
  [ "$ECONOMY_THINKING" = "-" ] || REMOTE_CMD="$REMOTE_CMD --economy-thinking $(shquote "$ECONOMY_THINKING")"
  [ "$WATCHER_THINKING" = "-" ] || REMOTE_CMD="$REMOTE_CMD --watcher-thinking $(shquote "$WATCHER_THINKING")"
  REMOTE_CMD="$REMOTE_CMD --autonomy $(shquote "$AUTONOMY")"
  REMOTE_CMD="$REMOTE_CMD --interview $(shquote "$INTERVIEW_MODE")"
  REMOTE_CMD="$REMOTE_CMD --thinking $(shquote "$THINKING")"
  [ "$HARNESS" = "langgraph" ] && REMOTE_CMD="$REMOTE_CMD --graph $(shquote "$LANGGRAPH_GRAPH")"
  [ -n "$EXECUTOR_COMMAND" ] && REMOTE_CMD="$REMOTE_CMD --executor-command $(shquote "$EXECUTOR_COMMAND")"
  [ -n "$ATTESTOR_COMMAND" ] && REMOTE_CMD="$REMOTE_CMD --attestor-command $(shquote "$ATTESTOR_COMMAND")"
  [ -n "$VALIDATOR_COMMAND" ] && REMOTE_CMD="$REMOTE_CMD --validator-command $(shquote "$VALIDATOR_COMMAND")"
  [ -n "$REVIEWER_COMMAND" ] && REMOTE_CMD="$REMOTE_CMD --reviewer-command $(shquote "$REVIEWER_COMMAND")"
  [ "$ALLOW_WORKER_NETWORK" = "1" ] && REMOTE_CMD="$REMOTE_CMD --allow-worker-network"
  [ -n "$WORKTREE_ROOT" ] && REMOTE_CMD="$REMOTE_CMD --worktree-root $(shquote "$WORKTREE_ROOT")"
  if [ "${#SCRUB_ENV[@]}" -gt 0 ]; then
    REMOTE_PREFIX=""
    for _w in "${SCRUB_ENV[@]}"; do REMOTE_PREFIX="$REMOTE_PREFIX $(shquote "$_w")"; done
    REMOTE_CMD="${REMOTE_PREFIX# } $REMOTE_CMD"
  fi
  exec ssh -- "$ON" "$REMOTE_CMD"
fi

# Harness dispatch. Every harness gets the SAME phase/gate/model-failure
# prompt strings (from scripts/lib/prompts.sh) — autonomy semantics and
# model-drift surfacing are identical across harnesses by construction.
FULL_PROMPT="$PHASE_PROMPT

$MODEL_FAILURE_PROMPT

$GATE_PROMPT

$INTERVIEW_PROMPT

$SEAT_PROMPT

GOAL: $GOAL"

case "$HARNESS" in
  langgraph)
    # The optional bridge owns its dependency check and emits an install hint.
    # Keep this branch isolated so every existing harness remains Python-free.
    LANGGRAPH_PYTHON="${BEASTMODE_PYTHON:-}"
    if [ -z "$LANGGRAPH_PYTHON" ] && [ -x "$SCRIPT_DIR/../.venv/bin/python" ]; then
      LANGGRAPH_PYTHON="$SCRIPT_DIR/../.venv/bin/python"
    fi
    LANGGRAPH_PYTHON="${LANGGRAPH_PYTHON:-python3}"
    LG_ARGS=("$SCRIPT_DIR/langgraph-runner" "$GOAL" \
      --autonomy "$AUTONOMY" \
      --graph "$LANGGRAPH_GRAPH" \
      --frontier "$FRONTIER" \
      --economy "$ECONOMY" \
      --watcher "$WATCHER")
    [ -n "$EXECUTOR_COMMAND" ] && LG_ARGS+=(--executor-command "$EXECUTOR_COMMAND")
    [ -n "$ATTESTOR_COMMAND" ] && LG_ARGS+=(--attestor-command "$ATTESTOR_COMMAND")
    [ -n "$VALIDATOR_COMMAND" ] && LG_ARGS+=(--validator-command "$VALIDATOR_COMMAND")
    [ -n "$REVIEWER_COMMAND" ] && LG_ARGS+=(--reviewer-command "$REVIEWER_COMMAND")
    [ "$ALLOW_WORKER_NETWORK" = "1" ] && LG_ARGS+=(--allow-worker-network)
    [ -n "$WORKTREE_ROOT" ] && LG_ARGS+=(--worktree-root "$WORKTREE_ROOT")
    # `bm goal run` pins the checkpoint thread, database and run directory to
    # the goal record so a later `bm goal resume` re-opens the same thread.
    [ -n "${BM_GOAL_ID:-}" ] && LG_ARGS+=(--thread-id "$BM_GOAL_ID")
    [ -n "${BM_LANGGRAPH_DB:-}" ] && LG_ARGS+=(--database "$BM_LANGGRAPH_DB")
    [ -n "${BM_RUN_DIR:-}" ] && LG_ARGS+=(--run-dir "$BM_RUN_DIR")
    [ -n "${BM_RESUME:-}" ] && LG_ARGS+=(--resume "$BM_RESUME")
    exec "${SCRUB_ENV[@]}" "$LANGGRAPH_PYTHON" "${LG_ARGS[@]}"
    ;;
  pi)
    # `bm` is commonly launched from a shell home directory (especially via
    # SSH).  Resolve a trusted repository before the permission preflight and
    # before Pi starts, rather than checking a relative `.pi/` path in `$PWD`.
    # An explicit BM_PROJECT_ROOT is preferred; otherwise use the enclosing
    # Git worktree.  Fail closed when neither is available.
    PI_PROJECT_ROOT="${BM_PROJECT_ROOT:-}"
    if [ -z "$PI_PROJECT_ROOT" ]; then
      PI_PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    fi
    if [ -z "$PI_PROJECT_ROOT" ] || [ ! -d "$PI_PROJECT_ROOT" ]; then
      echo "bm: Pi requires a trusted Git worktree; run from the repo or set BM_PROJECT_ROOT" >&2
      exit 2
    fi
    PI_PROJECT_ROOT="$(cd -- "$PI_PROJECT_ROOT" && pwd -P)"
    cd -- "$PI_PROJECT_ROOT"
    PI_POLICY_CHECK="$SCRIPT_DIR/check-pi-agent-policy"
    if [ ! -x "$PI_POLICY_CHECK" ] || ! "$PI_POLICY_CHECK" "$PI_PROJECT_ROOT"; then
      echo "bm: Pi agent permission preflight failed" >&2
      exit 2
    fi
    # Pi appends the installed package version in `pi list`; match the
    # canonical package name without requiring an exact unversioned line.
    if ! pi list 2>/dev/null | grep -Eq '^  npm:@gotgenes/pi-permission-system(@|$)'; then
      echo "bm: canonical Pi permission extension is not installed and active" >&2
      exit 2
    fi
    exec "${SCRUB_ENV[@]}" pi "${PI_ARGS[@]}" "$GOAL"
    ;;
  hermes)
    # Hermes ACN: one-shot Hermes agent preloaded with the beastmode skill.
    # The agent fans out via delegate_task (background/batch) per
    # adapters/hermes/SKILL.md. Director model = --model; provider is the
    # alias provider half.
    H_PROVIDER=""
    [ -n "$FRONTIER" ] && H_PROVIDER="${FRONTIER%%/*}"
    H_ARGS=(-z "$FULL_PROMPT" -s beastmode)
    [ -n "$FRONTIER" ]   && H_ARGS+=(--model "${FRONTIER#*/}")
    [ -n "$H_PROVIDER" ] && H_ARGS+=(--provider "$H_PROVIDER")
    # Autonomy controls phase progression, never tool permissions.
    exec "${SCRUB_ENV[@]}" hermes "${H_ARGS[@]}"
    ;;
  claude)
    # Reuse the read-only wrapper: it scrubs ambient API credentials, pins the
    # bare model, keeps plan permissions, and receives prompts only on stdin.
    C_EFFORT="$THINKING"
    case "$C_EFFORT" in none|minimal) C_EFFORT=low ;; esac
    printf '%s' "$FULL_PROMPT" | "$SCRIPT_DIR/claude-pro" \
      --model "${FRONTIER#*/}" --effort "$C_EFFORT"
    ;;
  codex)
    # Codex: exec one-shot. Adapter: adapters/codex/SKILL.md.
    # Beastmode aliases are provider-qualified for cross-harness provenance,
    # while the Codex CLI accepts the bare OpenAI model id.
    CODEX_MODEL="${FRONTIER#*/}"
    ORIGINAL_CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
    CODEX_WORKER_ROOT="${BEASTMODE_CODEX_STATE_ROOT:-${TMPDIR:-/tmp}/beastmode-codex-${UID:-0}-$$}"
    CODEX_WORKER_HOME="$CODEX_WORKER_ROOT/codex"
    mkdir -p "$CODEX_WORKER_HOME" \
      "$CODEX_WORKER_ROOT/cache" \
      "$CODEX_WORKER_ROOT/data" \
      "$CODEX_WORKER_ROOT/state" \
      "$CODEX_WORKER_ROOT/config"
    chmod 700 "$CODEX_WORKER_ROOT" "$CODEX_WORKER_HOME"
    if [ -r "$ORIGINAL_CODEX_HOME/auth.json" ]; then
      ln -sf "$ORIGINAL_CODEX_HOME/auth.json" "$CODEX_WORKER_HOME/auth.json"
    fi
    X_ARGS=(exec --ephemeral --ignore-user-config --model "$CODEX_MODEL" -c "model_reasoning_effort=\"$THINKING\"" "$FULL_PROMPT")
    CODEX_HOME="$CODEX_WORKER_HOME" \
      XDG_CACHE_HOME="$CODEX_WORKER_ROOT/cache" \
      XDG_DATA_HOME="$CODEX_WORKER_ROOT/data" \
      XDG_STATE_HOME="$CODEX_WORKER_ROOT/state" \
      XDG_CONFIG_HOME="$CODEX_WORKER_ROOT/config" \
      exec "${SCRUB_ENV[@]}" codex "${X_ARGS[@]}"
    ;;
esac
