#!/usr/bin/env bash
# bm — beastmode runner. One CLI to start a Beastmode goal from anywhere.
#
# Usage:
#   bm "<goal>"                              # default: local, pi harness, medium autonomy, auto models
#   bm "<goal>" --harness hermes             # Hermes ACN (async parallel sub-agents)
#   bm "<goal>" --harness claude|codex|langgraph # adapters / optional graph runtime
#   bm "<goal>" --gsd                        # force GSD phase gating
#   bm "<goal>" --on <remote-host>           # dispatch to a remote machine
#   bm "<goal>" --frontier sol --thinking medium
#   bm "<goal>" --watcher grok               # cross-family watcher seat
#   bm "<goal>" --autonomy low|medium|high   # default medium
#   bm "<goal>" --interview full|batched|assumptions|off # goal interview mode
#   bm "<goal>" --claude-subscription       # authorize one Claude Pro/Max watcher
#   bm "<goal>" --harness langgraph --executor-command '<child argv>' \
#      --attestor-command /trusted/attest --validator-command /trusted/validate \
#      --reviewer-command /trusted/review
#
# The goal can appear anywhere on the command line; flags are parsed first
# and the remaining args are joined into the goal string.
#
# Model aliases resolved in references/tier-aliases.md (tier model).
# Autonomy levels are defined in references/autonomy-levels.md.
# Shared prompt strings live in scripts/lib/prompts.sh; model
# preflight/postflight in scripts/enforce-models.
#
# Exit code: 0 = goal_complete surfaced; 1 = goal_blocked or watch failure;
# 2 = usage / config error.

set -euo pipefail

# SSH/non-interactive shells do not source a user's login profile. Keep the
# runner deterministic on macOS (Homebrew) and Linux (user-local installs) by
# exposing the standard executable locations before model preflight and
# harness dispatch. This is path discovery only; it never changes credentials
# or permission policy.
for bm_bin_dir in "$HOME/.local/bin" "/opt/homebrew/bin" "/usr/local/bin"; do
  if [ -d "$bm_bin_dir" ]; then
    case ":$PATH:" in
      *":$bm_bin_dir:"*) ;;
      *) PATH="$PATH:$bm_bin_dir" ;;
    esac
  fi
done
export PATH

GSD=0
ON="auto"
HARNESS="pi"
FRONTIER=""
# Keep the economy seat explicit so every harness pins the approved low-cost
# worker instead of inheriting a host/session default. Callers can override it
# with --economy for a deliberate alternate lane.
ECONOMY="luna-max"
ECONOMY_EXPLICIT=0
# Keep the input form separate from the resolved provider/model. Hermes uses
# a different authenticated provider namespace for Luna, so a friendly alias
# may be translated while an operator's explicit provider/model must remain
# untouched.
ECONOMY_INPUT_KIND="default"
WATCHER=""
CLAUDE_SUBSCRIPTION=0
AUTONOMY="medium"
INTERVIEW=""
THINKING="max"
LANGGRAPH_GRAPH="pipeline"
EXECUTOR_COMMAND=""
ATTESTOR_COMMAND=""
VALIDATOR_COMMAND=""
REVIEWER_COMMAND=""
ALLOW_WORKER_NETWORK=0
WORKTREE_ROOT=""
GOAL_PARTS=()
PRINT_HELP=0

# ponytail: aliases live in references/tier-aliases.json — one stdlib json
# lookup beats a 14-line bash case statement, and the file is the source of
# truth the docs reference. Fallback: pass the alias through unchanged so
# `pi` reports the real error instead of us silently mapping wrong.
# Look in the user-global file first, then the shipped file. Repository aliases
# are untrusted by default because a checkout must not be able to downgrade the
# requested model. Set BM_TRUST_REPO_ALIASES=1 only after reviewing that file.
# Resolve the launcher path before deriving sibling files.  On macOS the
# installed `~/.local/bin/bm` is a symlink to this script; using BASH_SOURCE
# directly makes SCRIPT_DIR point at ~/.local/bin and breaks `lib/prompts.sh`.
BM_SOURCE="${BASH_SOURCE[0]}"
while [ -h "$BM_SOURCE" ]; do
  BM_SOURCE_DIR="$(cd -P -- "$(dirname -- "$BM_SOURCE")" && pwd)"
  BM_SOURCE_LINK="$(readlink "$BM_SOURCE")"
  case "$BM_SOURCE_LINK" in
    /*) BM_SOURCE="$BM_SOURCE_LINK" ;;
    *) BM_SOURCE="$BM_SOURCE_DIR/$BM_SOURCE_LINK" ;;
  esac
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$BM_SOURCE")" && pwd)"
SHIP_ALIASES="${SCRIPT_DIR}/tier-aliases.json"

resolve_alias() {
  local alias="$1"
  [ -z "$alias" ] && { echo ""; return; }
  # Already a provider/model → pass through.
  [[ "$alias" == *"/"* ]] && { echo "$alias"; return; }

  local repo_aliases="$PWD/.beastmode/tier-aliases.json"
  local user_aliases="$HOME/.beastmode/tier-aliases.json"
  local candidates=("$user_aliases" "$SHIP_ALIASES")
  case "${BM_TRUST_REPO_ALIASES:-0}" in
    0|"") ;;
    1) candidates=("$repo_aliases" "${candidates[@]}") ;;
    *)
      echo "bm: BM_TRUST_REPO_ALIASES must be 0 or 1" >&2
      return 2
      ;;
  esac
  for f in "${candidates[@]}"; do
    [ -f "$f" ] || continue
    local hit
    if ! hit="$(python3 - "$f" "$alias" <<'PY'
import json
import sys

path, alias = sys.argv[1:]
try:
    with open(path, encoding="utf-8") as handle:
        data = json.load(handle)
except (OSError, json.JSONDecodeError) as exc:
    print(f"bm: invalid alias file {path}: {exc}", file=sys.stderr)
    raise SystemExit(2)

entry = data.get(alias)
if entry is None:
    raise SystemExit(0)
if not isinstance(entry, dict):
    print(f"bm: alias {alias!r} in {path} must be an object", file=sys.stderr)
    raise SystemExit(2)
provider = entry.get("provider")
model = entry.get("model")
if not all(isinstance(value, str) and value and len(value) <= 200 for value in (provider, model)):
    print(f"bm: alias {alias!r} in {path} needs non-empty provider and model strings", file=sys.stderr)
    raise SystemExit(2)
if "/" in provider or any(ord(char) < 32 for value in (provider, model) for char in value):
    print(f"bm: alias {alias!r} in {path} contains unsafe provider/model characters", file=sys.stderr)
    raise SystemExit(2)
print(f"{provider}/{model}")
PY
)"; then
      return 2
    fi
    [ -n "$hit" ] && { echo "$hit"; return; }
  done
  echo "bm: unknown model alias '$alias'; use a reviewed alias or provider/model" >&2
  return 2
}

usage() {
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

if [ $# -eq 0 ]; then
  usage
fi

# First pass: collect flags and non-flag args separately.
while [ $# -gt 0 ]; do
  case "$1" in
    --gsd)             GSD=1; shift ;;
    --harness)         HARNESS="${2:-pi}"; shift 2 ;;
    --harness=*)       HARNESS="${1#*=}"; shift ;;
    --on)              ON="${2:-auto}"; shift 2 ;;
    --on=*)            ON="${1#*=}"; shift ;;
    --frontier)        FRONTIER="${2:-}"; shift 2 ;;
    --frontier=*)      FRONTIER="${1#*=}"; shift ;;
    --economy)
      ECONOMY="${2:-}"
      ECONOMY_EXPLICIT=1
      [[ "$ECONOMY" == */* ]] && ECONOMY_INPUT_KIND="qualified" || ECONOMY_INPUT_KIND="friendly"
      shift 2
      ;;
    --economy=*)
      ECONOMY="${1#*=}"
      ECONOMY_EXPLICIT=1
      [[ "$ECONOMY" == */* ]] && ECONOMY_INPUT_KIND="qualified" || ECONOMY_INPUT_KIND="friendly"
      shift
      ;;
    --watcher)         WATCHER="${2:-}"; shift 2 ;;
    --watcher=*)       WATCHER="${1#*=}"; shift ;;
    --claude-subscription) CLAUDE_SUBSCRIPTION=1; shift ;;
    --graph)           LANGGRAPH_GRAPH="${2:-pipeline}"; shift 2 ;;
    --graph=*)         LANGGRAPH_GRAPH="${1#*=}"; shift ;;
    --executor-command) EXECUTOR_COMMAND="${2:-}"; shift 2 ;;
    --executor-command=*) EXECUTOR_COMMAND="${1#*=}"; shift ;;
    --attestor-command) ATTESTOR_COMMAND="${2:-}"; shift 2 ;;
    --attestor-command=*) ATTESTOR_COMMAND="${1#*=}"; shift ;;
    --validator-command) VALIDATOR_COMMAND="${2:-}"; shift 2 ;;
    --validator-command=*) VALIDATOR_COMMAND="${1#*=}"; shift ;;
    --reviewer-command) REVIEWER_COMMAND="${2:-}"; shift 2 ;;
    --reviewer-command=*) REVIEWER_COMMAND="${1#*=}"; shift ;;
    --allow-worker-network) ALLOW_WORKER_NETWORK=1; shift ;;
    --worktree-root)   WORKTREE_ROOT="${2:-}"; shift 2 ;;
    --worktree-root=*) WORKTREE_ROOT="${1#*=}"; shift ;;
    --autonomy)        AUTONOMY="${2:-medium}"; shift 2 ;;
    --autonomy=*)      AUTONOMY="${1#*=}"; shift ;;
    --interview)       INTERVIEW="${2:-}"; shift 2 ;;
    --interview=*)     INTERVIEW="${1#*=}"; shift ;;
    --thinking)        THINKING="${2:-max}"; shift 2 ;;
    --thinking=*)      THINKING="${1#*=}"; shift ;;
    -h|--help)         PRINT_HELP=1; shift ;;
    --)                shift; while [ $# -gt 0 ]; do GOAL_PARTS+=("$1"); shift; done ;;
    -*)                echo "bm: unknown arg: $1" >&2; usage ;;
    *)                 GOAL_PARTS+=("$1"); shift ;;
  esac
done

if [ "$PRINT_HELP" = "1" ]; then
  usage
fi

case "$AUTONOMY" in
  low|medium|high) ;;
  *) echo "bm: --autonomy must be low|medium|high (got: $AUTONOMY)" >&2; exit 2 ;;
esac

if [ -z "$INTERVIEW" ]; then
  case "$AUTONOMY" in
    low) INTERVIEW_MODE="full" ;;
    medium|high) INTERVIEW_MODE="batched" ;;
  esac
else
  INTERVIEW_MODE="$INTERVIEW"
fi
case "$INTERVIEW_MODE" in
  full|batched|assumptions|off) ;;
  *) echo "bm: --interview must be full|batched|assumptions|off (got: $INTERVIEW_MODE)" >&2; exit 2 ;;
esac

case "$HARNESS" in
  pi|hermes|claude|codex|langgraph) ;;
  *) echo "bm: --harness must be pi|hermes|claude|codex|langgraph (got: $HARNESS)" >&2; exit 2 ;;
esac

if [ "$HARNESS" = "langgraph" ] && [ "$LANGGRAPH_GRAPH" != "pipeline" ]; then
  echo "bm: --graph must be pipeline for the LangGraph harness" >&2
  exit 2
fi

case "$THINKING" in
  none|minimal|low|medium|high|xhigh|max) ;;
  *) echo "bm: --thinking must be none|minimal|low|medium|high|xhigh|max (got: $THINKING)" >&2; exit 2 ;;
esac

GOAL="${GOAL_PARTS[*]:-}"
[ -z "$GOAL" ] && usage

# Resolve aliases after parsing so the help path stays side-effect free.
if [ -n "$FRONTIER" ] && ! FRONTIER="$(resolve_alias "$FRONTIER")"; then exit 2; fi
if [ -n "$ECONOMY" ] && ! ECONOMY="$(resolve_alias "$ECONOMY")"; then exit 2; fi
# Hermes names its authenticated Luna provider `vibeproxy`, while Pi/Codex
# use the `openai-codex` namespace. Translate the implicit default and
# friendly aliases so the request remains model-pinned without rewriting an
# operator's explicit provider/model override. A qualified input remains
# explicit.
if [ "$HARNESS" = "hermes" ] && [ "$ECONOMY_INPUT_KIND" != "qualified" ] \
  && [ "$ECONOMY" = "openai-codex/gpt-5.6-luna" ]; then
  ECONOMY="vibeproxy/gpt-5.6-luna"
fi
if [ -n "$WATCHER" ] && ! WATCHER="$(resolve_alias "$WATCHER")"; then exit 2; fi

# Claude Pro/Max is an explicit, single-seat watcher path. It uses
# `claude -p` and the signed-in subscription quota, not the Anthropic API
# OAuth pool. Keep this opt-in and fail closed if a caller turns it into a
# multi-seat fan-out or uses a different harness.
if [ "$CLAUDE_SUBSCRIPTION" = "1" ]; then
  if [ "$HARNESS" != "claude" ]; then
    echo "bm: --claude-subscription requires --harness claude" >&2
    exit 2
  fi
  claude_seats=0
  for seat in "$FRONTIER" "$ECONOMY" "$WATCHER"; do
    [ -z "$seat" ] && continue
    case "$seat" in
      anthropic/*|*claude*) claude_seats=$((claude_seats + 1)) ;;
    esac
  done
  if [ "$claude_seats" -ne 1 ]; then
    echo "bm: --claude-subscription requires exactly one Claude seat, got $claude_seats" >&2
    exit 2
  fi
  if [ -z "$FRONTIER" ]; then
    echo "bm: --claude-subscription requires --frontier fable|opus|opus5 to pin the watcher model" >&2
    exit 2
  fi
  export BM_ALLOW_CLAUDE_OAUTH=1
fi

# Circuit breaker: never fan out a Claude seat on subscription OAuth (the
# ToS-ban pattern). OAuth path = ANTHROPIC_API_KEY unset. Interactive runs may
# approve via prompt; non-interactive (subagent/Codex) must be pre-authorized
# with BM_ALLOW_CLAUDE_OAUTH=1 by Luis. ponytail: one gate covers all seats.
for seat in "$FRONTIER" "$ECONOMY" "$WATCHER"; do
  [ -z "$seat" ] && continue
  case "$seat" in
    anthropic/*|*claude*) ;;
    *) continue ;;
  esac
  [ -n "${ANTHROPIC_API_KEY:-}" ] && continue          # API-key billing: fine
  [ "${BM_ALLOW_CLAUDE_OAUTH:-0}" = "1" ] && continue  # pre-authorized by Luis
  if [ -t 0 ] && [ -t 1 ]; then
    printf 'bm: BREAKER: seat "%s" is a Claude model on subscription OAuth (no ANTHROPIC_API_KEY).\n' "$seat" >&2
    printf 'bm: Fan-out of Claude seats on OAuth risks the Anthropic ToS ban. Authorize this run? [y/N] ' >&2
    read -r _bm_oauth_ok
    case "$_bm_oauth_ok" in y|Y|yes) continue ;; esac
  fi
  echo "bm: BREAKER: blocked Claude OAuth seat '$seat'. Luis must re-run with BM_ALLOW_CLAUDE_OAUTH=1 after approval." >&2
  exit 3
done

if [ "$HARNESS" = "codex" ] && [ -z "$FRONTIER" ]; then
  echo "bm: --harness codex requires --frontier <alias|provider/model> so the model is pinned" >&2
  exit 2
fi

# Resolve --on auto: prefer remote if BM_AUTO_TARGET is set, else local.
if [ "$ON" = "auto" ]; then
  ON="${BM_AUTO_TARGET:-local}"
fi

# ponytail: a goal is the only input before design. Print a transparent rough
# baseline now; replace it with measured phase history when that exists.
python3 "$SCRIPT_DIR/phase-estimate" "$GOAL"

# Shared prompt library (extracted from this script in v2.2). Source, not exec.
# shellcheck source=lib/prompts.sh
. "$SCRIPT_DIR/lib/prompts.sh"

# ponytail: validate resolved aliases BEFORE spawning the agent, per harness.
# enforce-models checks pi against `pi --list-models`, hermes against the
# configured providers, claude/codex against CLI presence. Exit 2 with
# alternatives instead of letting the harness crash mid-goal. Skip with
# BM_SKIP_MODEL_CHECK=1 (CI / scripted runs) or for remote dispatch.
if [ "$ON" = "local" ] && [ "${BM_SKIP_MODEL_CHECK:-0}" != "1" ]; then
  ENF_ARGS=(--harness "$HARNESS")
  for model in "$FRONTIER" "$ECONOMY" "$WATCHER"; do
    [ -z "$model" ] && continue
    [[ "$model" != *"/"* ]] && continue  # bare alias w/ no resolution
    ENF_ARGS+=(--model "$model")
  done
  if [ "${#ENF_ARGS[@]}" -gt 2 ]; then
    "$SCRIPT_DIR/enforce-models" "${ENF_ARGS[@]}"
  fi
fi

# Build harness arguments once (used in local run).
PHASE_PROMPT="$(bm_phase_prompt)"
MODEL_FAILURE_PROMPT="$(bm_model_failure_prompt "$AUTONOMY")"
GATE_PROMPT="$(bm_gate_prompt "$AUTONOMY")"
INTERVIEW_PROMPT=""
[ "$INTERVIEW_MODE" != "off" ] && INTERVIEW_PROMPT="$(bm_interview_prompt "$INTERVIEW_MODE")"
[ "$GSD" = "1" ] && PHASE_PROMPT="Use GSD phase gating: gsd-plan-phase, gsd-execute-phase, gsd-verify-work, gsd-ship. $PHASE_PROMPT"
SEAT_PROMPT="Seats: director=$FRONTIER economy=$ECONOMY watcher=${WATCHER:-unset}. Pin the executor model on every child; never let economy work inherit a session default. Each child returns meta.json with requested_model and actual_model."
PI_ARGS=(--skill ~/.agents/skills/beastmode-pi/SKILL.md --print --no-session --thinking "$THINKING" --append-system-prompt "$PHASE_PROMPT $MODEL_FAILURE_PROMPT $GATE_PROMPT $INTERVIEW_PROMPT $SEAT_PROMPT")
if [ -n "$FRONTIER" ]; then
  PI_ARGS+=(--model "$FRONTIER")
elif [ -n "$ECONOMY" ]; then
  PI_ARGS+=(--model "$ECONOMY")
else
  # Pin the unqualified Beastmode path to the approved cheap worker.
  PI_ARGS+=(--model "openai-codex/gpt-5.6-luna")
fi
# ponytail: build the --models list from the seats that were actually set.
# `--models "$FRONTIER,$ECONOMY"` handed pi a leading comma whenever --economy
# was given without --frontier, which is a legal invocation.
MODELS_CSV=""
for seat_model in "$FRONTIER" "$ECONOMY"; do
  [ -z "$seat_model" ] && continue
  MODELS_CSV="${MODELS_CSV:+$MODELS_CSV,}$seat_model"
done
[ -n "$ECONOMY" ]      && PI_ARGS+=(--models "$MODELS_CSV")
[ "$AUTONOMY" = "low" ]  && PI_ARGS+=(--approve)
# High autonomy must still let the director inspect the repository. Disabling
# every built-in tool made headless Luna runs unverifiable: the model could
# neither read source nor search the worktree, while the workflow extensions
# remained loaded. Keep the read/search built-ins and fail closed on mutation;
# the project permission policy continues to govern bash/MCP and all external
# paths.
[ "$AUTONOMY" = "high" ] && PI_ARGS+=(--exclude-tools bash,edit,write)

# Remote dispatch: hand the goal to the selected remote host over SSH and tail the goal log.
# ponytail: foreground SSH so the user sees the live goal stream. If they want
# fire-and-forget, run `bm --on $ON ... &` themselves or use --autonomy high.
if [ "$ON" != "local" ]; then
  if ! command -v ssh >/dev/null 2>&1; then
    echo "bm: --on $ON needs ssh in PATH" >&2; exit 2
  fi
  if [[ ! "$ON" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "bm: --on must be a host alias or hostname, not an ssh option" >&2
    exit 2
  fi
  # ponytail: everything crossing the ssh boundary gets single-quoted with
  # embedded quotes escaped. The old form spliced the raw goal into
  # `bm '$GOAL' ...`, so any apostrophe ("don't drop the index") ended the
  # quote and the rest of the goal was executed as remote shell words.
  # POSIX single-quoting rather than printf %q — %q can emit bash-only
  # $'...' forms and the remote login shell is not guaranteed to be bash.
  shquote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
  REMOTE_CMD="bm $(shquote "$GOAL")"
  [ "$GSD" = "1" ]   && REMOTE_CMD="$REMOTE_CMD --gsd"
  REMOTE_CMD="$REMOTE_CMD --harness $(shquote "$HARNESS")"
  [ "$CLAUDE_SUBSCRIPTION" = "1" ] && REMOTE_CMD="$REMOTE_CMD --claude-subscription"
  [ -n "$FRONTIER" ] && REMOTE_CMD="$REMOTE_CMD --frontier $(shquote "$FRONTIER")"
  [ -n "$ECONOMY" ]  && REMOTE_CMD="$REMOTE_CMD --economy $(shquote "$ECONOMY")"
  [ -n "$WATCHER" ]  && REMOTE_CMD="$REMOTE_CMD --watcher $(shquote "$WATCHER")"
  REMOTE_CMD="$REMOTE_CMD --autonomy $(shquote "$AUTONOMY")"
  REMOTE_CMD="$REMOTE_CMD --interview $(shquote "$INTERVIEW_MODE")"
  REMOTE_CMD="$REMOTE_CMD --thinking $(shquote "$THINKING")"
  [ "$HARNESS" = "langgraph" ] && REMOTE_CMD="$REMOTE_CMD --graph $(shquote "$LANGGRAPH_GRAPH")"
  [ -n "$EXECUTOR_COMMAND" ] && REMOTE_CMD="$REMOTE_CMD --executor-command $(shquote "$EXECUTOR_COMMAND")"
  [ -n "$ATTESTOR_COMMAND" ] && REMOTE_CMD="$REMOTE_CMD --attestor-command $(shquote "$ATTESTOR_COMMAND")"
  [ -n "$VALIDATOR_COMMAND" ] && REMOTE_CMD="$REMOTE_CMD --validator-command $(shquote "$VALIDATOR_COMMAND")"
  [ -n "$REVIEWER_COMMAND" ] && REMOTE_CMD="$REMOTE_CMD --reviewer-command $(shquote "$REVIEWER_COMMAND")"
  [ "$ALLOW_WORKER_NETWORK" = "1" ] && REMOTE_CMD="$REMOTE_CMD --allow-worker-network"
  [ -n "$WORKTREE_ROOT" ] && REMOTE_CMD="$REMOTE_CMD --worktree-root $(shquote "$WORKTREE_ROOT")"
  exec ssh -- "$ON" "$REMOTE_CMD"
fi

# Harness dispatch. Every harness gets the SAME phase/gate/model-failure
# prompt strings (from scripts/lib/prompts.sh) — autonomy semantics and
# model-drift surfacing are identical across harnesses by construction.
FULL_PROMPT="$PHASE_PROMPT

$MODEL_FAILURE_PROMPT

$GATE_PROMPT

$INTERVIEW_PROMPT

$SEAT_PROMPT

GOAL: $GOAL"

case "$HARNESS" in
  langgraph)
    # The optional bridge owns its dependency check and emits an install hint.
    # Keep this branch isolated so every existing harness remains Python-free.
    LANGGRAPH_PYTHON="${BEASTMODE_PYTHON:-}"
    if [ -z "$LANGGRAPH_PYTHON" ] && [ -x "$SCRIPT_DIR/../.venv/bin/python" ]; then
      LANGGRAPH_PYTHON="$SCRIPT_DIR/../.venv/bin/python"
    fi
    LANGGRAPH_PYTHON="${LANGGRAPH_PYTHON:-python3}"
    LG_ARGS=("$SCRIPT_DIR/langgraph-runner" "$GOAL" \
      --autonomy "$AUTONOMY" \
      --graph "$LANGGRAPH_GRAPH" \
      --frontier "$FRONTIER" \
      --economy "$ECONOMY" \
      --watcher "$WATCHER")
    [ -n "$EXECUTOR_COMMAND" ] && LG_ARGS+=(--executor-command "$EXECUTOR_COMMAND")
    [ -n "$ATTESTOR_COMMAND" ] && LG_ARGS+=(--attestor-command "$ATTESTOR_COMMAND")
    [ -n "$VALIDATOR_COMMAND" ] && LG_ARGS+=(--validator-command "$VALIDATOR_COMMAND")
    [ -n "$REVIEWER_COMMAND" ] && LG_ARGS+=(--reviewer-command "$REVIEWER_COMMAND")
    [ "$ALLOW_WORKER_NETWORK" = "1" ] && LG_ARGS+=(--allow-worker-network)
    [ -n "$WORKTREE_ROOT" ] && LG_ARGS+=(--worktree-root "$WORKTREE_ROOT")
    exec "$LANGGRAPH_PYTHON" "${LG_ARGS[@]}"
    ;;
  pi)
    PI_POLICY_CHECK="$SCRIPT_DIR/check-pi-agent-policy"
    if [ ! -x "$PI_POLICY_CHECK" ] || ! "$PI_POLICY_CHECK" "$PWD"; then
      echo "bm: Pi agent permission preflight failed" >&2
      exit 2
    fi
    # Pi appends the installed package version in `pi list`; match the
    # canonical package name without requiring an exact unversioned line.
    if ! pi list 2>/dev/null | grep -Eq '^  npm:@gotgenes/pi-permission-system(@|$)'; then
      echo "bm: canonical Pi permission extension is not installed and active" >&2
      exit 2
    fi
    exec pi "${PI_ARGS[@]}" "$GOAL"
    ;;
  hermes)
    # Hermes ACN: one-shot Hermes agent preloaded with the beastmode skill.
    # The agent fans out via delegate_task (background/batch) per
    # adapters/hermes/SKILL.md. Director model = --model; provider is the
    # alias provider half.
    H_PROVIDER=""
    [ -n "$FRONTIER" ] && H_PROVIDER="${FRONTIER%%/*}"
    H_ARGS=(-z "$FULL_PROMPT" -s beastmode)
    [ -n "$FRONTIER" ]   && H_ARGS+=(--model "${FRONTIER#*/}")
    [ -n "$H_PROVIDER" ] && H_ARGS+=(--provider "$H_PROVIDER")
    # Autonomy controls phase progression, never tool permissions.
    exec hermes "${H_ARGS[@]}"
    ;;
  claude)
    # Claude Code: print-mode one-shot. Adapter: adapters/claude-code/SKILL.md.
    # ponytail: the claude CLI takes a bare model id, not provider/model —
    # `--frontier opus` resolves to anthropic/claude-opus-4-7 and the CLI
    # rejects the provider half. Strip it here, the way the hermes branch
    # already splits provider from model, instead of asking the caller to
    # remember which harness wants which form.
    C_ARGS=(-p "$FULL_PROMPT")
    [ -n "$FRONTIER" ] && C_ARGS+=(--model "${FRONTIER#*/}")
    # Claude's normal permission controls remain active at every autonomy.
    exec claude "${C_ARGS[@]}"
    ;;
  codex)
    # Codex: exec one-shot. Adapter: adapters/codex/SKILL.md.
    # Beastmode aliases are provider-qualified for cross-harness provenance,
    # while the Codex CLI accepts the bare OpenAI model id.
    CODEX_MODEL="${FRONTIER#*/}"
    ORIGINAL_CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
    CODEX_WORKER_ROOT="${BEASTMODE_CODEX_STATE_ROOT:-${TMPDIR:-/tmp}/beastmode-codex-${UID:-0}-$$}"
    CODEX_WORKER_HOME="$CODEX_WORKER_ROOT/codex"
    mkdir -p "$CODEX_WORKER_HOME" \
      "$CODEX_WORKER_ROOT/cache" \
      "$CODEX_WORKER_ROOT/data" \
      "$CODEX_WORKER_ROOT/state" \
      "$CODEX_WORKER_ROOT/config"
    chmod 700 "$CODEX_WORKER_ROOT" "$CODEX_WORKER_HOME"
    if [ -r "$ORIGINAL_CODEX_HOME/auth.json" ]; then
      ln -sf "$ORIGINAL_CODEX_HOME/auth.json" "$CODEX_WORKER_HOME/auth.json"
    fi
    X_ARGS=(exec --ephemeral --ignore-user-config --model "$CODEX_MODEL" -c "model_reasoning_effort=\"$THINKING\"" "$FULL_PROMPT")
    CODEX_HOME="$CODEX_WORKER_HOME" \
      XDG_CACHE_HOME="$CODEX_WORKER_ROOT/cache" \
      XDG_DATA_HOME="$CODEX_WORKER_ROOT/data" \
      XDG_STATE_HOME="$CODEX_WORKER_ROOT/state" \
      XDG_CONFIG_HOME="$CODEX_WORKER_ROOT/config" \
      exec codex "${X_ARGS[@]}"
    ;;
esac
