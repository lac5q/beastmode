        "Front-door merge gate",
        "Any goal_blocked",
        "Any model failure"
      ]
    },
    "high": {
      "runs_without_surfacing": [
        "Multi-phase until goal_complete or 3 identical goal_blocked in a row with concrete evidence",
        "One safe workaround after a model failure"
      ],
      "always_surfaces": [
        "budget_limited stop",
        "Watcher unavailable after all 3 tiers",
        "No watcher, no validated violation",
