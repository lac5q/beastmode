{
  "default": "medium",
  "gates_blocking_below_high": true,
  "model_drift_always_surfaces": true,
  "levels": {
    "low": {
      "interview": {
        "upfront": "full",
        "in_process": "gate-questions",
        "question_budget": null
      },
      "runs_without_surfacing": [
        "Single executor turn, one read-only tool call"
      ],
      "always_surfaces": [
        "Every phase transition",
        "Every merge",
        "Every cross-tier escalation",
        "Every Worker → Watcher jump",
        "Any diff > 1 file",
        "Any model failure"
      ]
    },
    "medium": {
      "interview": {
        "upfront": "batched",
        "in_process": "gate-questions",
        "question_budget": 5
      },
      "runs_without_surfacing": [
        "Whole phase: acceptance → design package → delegate → validate → review"
      ],
      "always_surfaces": [
        "Security/auth/payments/data-loss events",
        "Tier-2/3 Watcher fallback",
        "Front-door merge gate",
        "Any goal_blocked",
        "Any model failure"
      ]
    },
    "high": {
      "interview": {
        "upfront": "batched",
        "in_process": "escalation-only",
        "question_budget": 5
      },
      "runs_without_surfacing": [
        "Multi-phase until goal_complete or 3 identical goal_blocked in a row with concrete evidence",
        "One safe workaround after a model failure"
      ],
      "always_surfaces": [
        "budget_limited stop",
        "Watcher unavailable after all 3 tiers",
        "No watcher, no validated violation",
        "telegram-bound secrets in prompt",
        "Model failure + workaround result"
      ]
    }
  },
  "interview_protocol": "references/goal-interview.md",
  "reporting": {
    "ledger": ".beastmode/LEDGER.md",
    "digest_cadence": "every phase gate and at least hourly",
    "final_worker_table": true
  }
}
